      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:00.560" end="00:00:01.920">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:02.320" end="00:00:05.680">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:08.200" end="00:00:11.160">
        <tt:span style="textWhite">Willkommen zur</tt:span>
        <tt:br />
        <tt:span style="textWhite">tagesschau in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:11.720" end="00:00:15.720">
        <tt:span style="textWhite">Ich bin Susanne Stichler</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:30.400" end="00:00:32.800">
        <tt:span style="textWhite">Und nun zur ersten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:37.880" end="00:00:43.160">
        <tt:span style="textWhite">PHP ist eine Programmiersprache</tt:span>
        <tt:br />
        <tt:span style="textWhite">für das Internet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:43.760" end="00:00:49.080">
        <tt:span style="textWhite">Das heißt, mit PHP kann man</tt:span>
        <tt:br />
        <tt:span style="textWhite">Sachen ins Internet stellen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:49.920" end="00:00:54.720">
        <tt:span style="textWhite">Jetzt haben Fachleute gemerkt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei PHP gibt es</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:54.760" end="00:00:57.600">
        <tt:span style="textWhite">ein großes Problem</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Sicherheit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:57.640" end="00:01:04.520">
        <tt:span style="textWhite">Kriminelle könnten das ausnutzen</tt:span>
        <tt:br />
        <tt:span style="textWhite">und z.B. an geheime Daten kommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:01:05.480" end="00:01:08.800">
        <tt:span style="textWhite">Deshalb haben viele Firmen und Ämter</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:08.840" end="00:01:12.480">
        <tt:span style="textWhite">ihre Internetseiten</tt:span>
        <tt:br />
        <tt:span style="textWhite">erst mal abgeschaltet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:13.120" end="00:01:19.080">
        <tt:span style="textWhite">Wenn man auf die Internetseite will,</tt:span>
        <tt:br />
        <tt:span style="textWhite">bekommt man eine Fehlermeldung,</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:19.200" end="00:01:20.400">
        <tt:span style="textWhite">wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:21.320" end="00:01:24.760">
        <tt:span style="textWhite">Zu dem Problem bei PHP</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:26.680" end="00:01:30.520">
        <tt:span style="textWhite">Viele Seiten im Internet</tt:span>
        <tt:br />
        <tt:span style="textWhite">funktionieren nicht wie sonst.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:30.840" end="00:01:32.960">
        <tt:span style="textWhite">Die Seiten sind abgeschaltet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:33.240" end="00:01:36.680">
        <tt:span style="textWhite">Wegen dem Problem</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Sicherheit bei PHP.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:37.720" end="00:01:43.280">
        <tt:span style="textWhite">Kriminelle sollen keine Möglichkeit</tt:span>
        <tt:br />
        <tt:span style="textWhite">bekommen, Daten zu kopieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:43.960" end="00:01:46.120">
        <tt:span style="textWhite">Dieser Internetfachmann sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:46.320" end="00:01:48.840">
        <tt:span style="textWhite">Die Kriminellen</tt:span>
        <tt:br />
        <tt:span style="textWhite">greifen jetzt schon an.</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:48.880" end="00:01:50.840">
        <tt:span style="textWhite">Wir müssen uns beeilen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:50.880" end="00:01:54.840">
        <tt:span style="textWhite">Die Kriminellen</tt:span>
        <tt:br />
        <tt:span style="textWhite">greifen nicht nur selbst an,</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:55.040" end="00:01:59.360">
        <tt:span style="textWhite">sie benutzen auch</tt:span>
        <tt:br />
        <tt:span style="textWhite">künstliche Intelligenz, KI.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:02:00.080" end="00:02:02.160">
        <tt:span style="textWhite">Ein anderer Internetfachmann sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:02:02.200" end="00:02:06.000">
        <tt:span style="textWhite">Die Firmen verteidigen ihre Seiten</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen menschliche Angriffe.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:06.040" end="00:02:09.760">
        <tt:span style="textWhite">Aber wenn KI angreift,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dann ist der Angriff zu stark.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:10.240" end="00:02:14.480">
        <tt:span style="textWhite">Die Betreiber von den Internetseiten</tt:span>
        <tt:br />
        <tt:span style="textWhite">müssen sich beeilen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:14.520" end="00:02:18.440">
        <tt:span style="textWhite">Sie müssen schnell PHP aktualisieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:18.880" end="00:02:22.200">
        <tt:span style="textWhite">Experten warnen</tt:span>
        <tt:br />
        <tt:span style="textWhite">auch die Internetnutzer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:22.480" end="00:02:25.080">
        <tt:span style="textWhite">Z.B. vor falschen Mails.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:25.720" end="00:02:30.240">
        <tt:span style="textWhite">Man soll vorsichtig sein,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wo man seine Daten eingibt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:31.280" end="00:02:33.920">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:38.720" end="00:02:41.480">
        <tt:span style="textWhite">Meta ist eine große Internetfirma.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:41.520" end="00:02:47.040">
        <tt:span style="textWhite">Zu Meta gehören</tt:span>
        <tt:br />
        <tt:span style="textWhite">z.B. Instagram und Facebook.</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:47.680" end="00:02:52.480">
        <tt:span style="textWhite">Vor einigen Jahren gab es</tt:span>
        <tt:br />
        <tt:span style="textWhite">ein großes Problem bei Facebook.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:53.000" end="00:02:57.040">
        <tt:span style="textWhite">Eine andere Firma</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat von vielen Facebook-Nutzern</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:57.080" end="00:02:58.680">
        <tt:span style="textWhite">Daten untersucht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:59.480" end="00:03:02.760">
        <tt:span style="textWhite">Das hatten die Nutzer</tt:span>
        <tt:br />
        <tt:span style="textWhite">aber gar nicht erlaubt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:03:03.640" end="00:03:08.960">
        <tt:span style="textWhite">Jetzt hat ein Gericht in dem Land USA</tt:span>
        <tt:br />
        <tt:span style="textWhite">dazu ein Urteil gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:03:09.000" end="00:03:14.040">
        <tt:span style="textWhite">Meta muss</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Mrd. Dollar Strafe zahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:03:14.520" end="00:03:16.360">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:16.920" end="00:03:20.160">
        <tt:span style="textWhite">Die Firma Cambridge Analytica.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:20.200" end="00:03:24.400">
        <tt:span style="textWhite">Sie hat die Daten von vielen</tt:span>
        <tt:br />
        <tt:span style="textWhite">Facebook-Nutzern untersucht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:24.640" end="00:03:26.160">
        <tt:span style="textWhite">Ohne Erlaubnis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:26.600" end="00:03:31.040">
        <tt:span style="textWhite">Die Firma hat damit sehr oft</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen Gesetze verstoßen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:31.080" end="00:03:36.040">
        <tt:span style="textWhite">Die Daten sollen u.a. von Politikern</tt:span>
        <tt:br />
        <tt:span style="textWhite">genutzt worden sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:36.400" end="00:03:42.240">
        <tt:span style="textWhite">Z.B. bei der Wahl von Donald Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">zum Präsidenten von dem Land USA.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:43.200" end="00:03:46.960">
        <tt:span style="textWhite">Mithilfe der Daten wurde gezielt</tt:span>
        <tt:br />
        <tt:span style="textWhite">Werbung für die Wahl</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:47.000" end="00:03:48.800">
        <tt:span style="textWhite">von Donald Trump gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:49.160" end="00:03:52.080">
        <tt:span style="textWhite">In den USA,</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Bundesstaat New Mexico,</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:52.480" end="00:03:55.600">
        <tt:span style="textWhite">gab es deshalb</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen Prozess vor Gericht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:55.640" end="00:04:01.480">
        <tt:span style="textWhite">Das Gericht sagt, in New Mexico waren</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Facebook-Nutzer betroffen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:04:01.760" end="00:04:06.960">
        <tt:span style="textWhite">Deshalb muss Meta</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Mrd. Dollar Strafe zahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:04:07.480" end="00:04:11.360">
        <tt:span style="textWhite">Dieser Mann hat New Mexico</tt:span>
        <tt:br />
        <tt:span style="textWhite">vor Gericht vertreten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:04:11.760" end="00:04:15.840">
        <tt:span style="textWhite">Er sagt, das Urteil</tt:span>
        <tt:br />
        <tt:span style="textWhite">soll eine Warnung sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:04:16.040" end="00:04:18.960">
        <tt:span style="textWhite">An alle großen Internetfirmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:04:19.600" end="00:04:21.520">
        <tt:span style="textWhite">Meta will wahrscheinlich</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:04:21.560" end="00:04:24.520">
        <tt:span style="textWhite">einen Widerspruch</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen das Urteil machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:24.560" end="00:04:29.400">
        <tt:span style="textWhite">Dann muss ein höheres Gericht</tt:span>
        <tt:br />
        <tt:span style="textWhite">noch einmal entscheiden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:30.400" end="00:04:32.600">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:36.280" end="00:04:40.160">
        <tt:span style="textWhite">In Brandenburg, rechts,</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Osten von Deutschland,</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:40.200" end="00:04:43.400">
        <tt:span style="textWhite">hat die Polizei</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen Mann festgenommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:43.720" end="00:04:48.800">
        <tt:span style="textWhite">Die Behörden sagen, der Mann</tt:span>
        <tt:br />
        <tt:span style="textWhite">könnte ein Spion für Russland sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:49.360" end="00:04:53.120">
        <tt:span style="textWhite">Russland führt einen Krieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen die Ukraine.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:53.160" end="00:04:56.640">
        <tt:span style="textWhite">Und der Mann</tt:span>
        <tt:br />
        <tt:span style="textWhite">soll wichtige Informationen</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:56.680" end="00:04:59.960">
        <tt:span style="textWhite">für die russische Armee</tt:span>
        <tt:br />
        <tt:span style="textWhite">gesammelt haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:05:00.520" end="00:05:05.480">
        <tt:span style="textWhite">Z.B. Informationen</tt:span>
        <tt:br />
        <tt:span style="textWhite">über Panzer und Munition.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:05:06.320" end="00:05:12.480">
        <tt:span style="textWhite">Diese geheimen Informationen soll er</tt:span>
        <tt:br />
        <tt:span style="textWhite">an Russland weitergegeben haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:05:13.200" end="00:05:15.560">
        <tt:span style="textWhite">Der Mann muss deshalb</tt:span>
        <tt:br />
        <tt:span style="textWhite">jetzt vielleicht</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:05:15.600" end="00:05:17.600">
        <tt:span style="textWhite">erst mal ins Gefängnis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:05:17.640" end="00:05:20.600">
        <tt:span style="textWhite">Darüber entscheidet ein Richter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:05:21.680" end="00:05:24.320">
        <tt:span style="textWhite">Und das waren unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:39.760" end="00:05:41.960">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:42.880" end="00:05:46.920">
        <tt:span style="textWhite">Rechts im Osten und unten im Süden</tt:span>
        <tt:br />
        <tt:span style="textWhite">scheint die Sonne.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:47.160" end="00:05:50.480">
        <tt:span style="textWhite">Sonst gibt es viele Wolken und Regen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:50.760" end="00:05:53.400">
        <tt:span style="textWhite">Es werden 8 bis 16 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:54.240" end="00:05:57.520">
        <tt:span style="textWhite">Das war die</tt:span>
        <tt:br />
        <tt:span style="textWhite">tagesschau in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:57.920" end="00:06:00.280">
        <tt:span style="textWhite">Tschüss und bis zum nächsten Mal.</tt:span>
      </tt:p>
