      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:03.890" end="00:00:04.890">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:06.450" end="00:00:09.170">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:11.490" end="00:00:14.970">
        <tt:span style="textWhite">Willkommen zur tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:15.370" end="00:00:19.370">
        <tt:span style="textWhite">Ich bin Susanne Stichler</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:39.610" end="00:00:41.690">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:47.010" end="00:00:49.090">
        <tt:span style="textWhite">In Berlin gab es gerade</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:49.130" end="00:00:52.210">
        <tt:span style="textWhite">ein großes Treffen</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:52.810" end="00:00:58.610">
        <tt:span style="textWhite">Die Bundesregierung hat Investoren</tt:span>
        <tt:br />
        <tt:span style="textWhite">aus der ganzen Welt dazu eingeladen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:59.010" end="00:01:02.810">
        <tt:span style="textWhite">Investoren sind Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit viel Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:01:03.450" end="00:01:08.010">
        <tt:span style="textWhite">Sie geben das Geld zum Beispiel</tt:span>
        <tt:br />
        <tt:span style="textWhite">für den Bau von Firmen aus.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:01:09.570" end="00:01:11.850">
        <tt:span style="textWhite">Die Bundesregierung will,</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:11.890" end="00:01:16.450">
        <tt:span style="textWhite">dass viele Investoren</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Deutschland Geld ausgeben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:17.290" end="00:01:22.730">
        <tt:span style="textWhite">In der Mitte von dem Foto</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist der Bundeskanzler Friedrich Merz.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:23.370" end="00:01:29.010">
        <tt:span style="textWhite">Er sagt, Investoren aus dem Ausland</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind gut für die deutsche Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:30.690" end="00:01:34.850">
        <tt:span style="textWhite">Es gab ein großes Fest</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Investoren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:35.610" end="00:01:40.570">
        <tt:span style="textWhite">Sie wollen viele Milliarden Euro</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Deutschland investieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:40.970" end="00:01:43.330">
        <tt:span style="textWhite">Jetzt zeigen wir einen Film dazu.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:44.290" end="00:01:49.010">
        <tt:span style="textWhite">Bei dem Fest sind viele Investoren</tt:span>
        <tt:br />
        <tt:span style="textWhite">aus der ganzen Welt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:49.410" end="00:01:52.410">
        <tt:span style="textWhite">Der Bundeskanzler Friedrich Merz</tt:span>
        <tt:br />
        <tt:span style="textWhite">sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:52.650" end="00:01:55.850">
        <tt:span style="textWhite">Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">will Investoren und Handel</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:55.930" end="00:01:59.490">
        <tt:span style="textWhite">und die deutsche Wirtschaft</tt:span>
        <tt:br />
        <tt:span style="textWhite">will schneller wachsen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:02:02.370" end="00:02:07.970">
        <tt:span style="textWhite">Jen-Hsun Huang ist der Chef</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Firma Nvidia in den USA.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:02:08.570" end="00:02:13.530">
        <tt:span style="textWhite">Sie macht Chips für Computer</tt:span>
        <tt:br />
        <tt:span style="textWhite">und ist eine sehr wertvolle Firma.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:02:14.410" end="00:02:17.570">
        <tt:span style="textWhite">Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">will mit Nvidia zusammenarbeiten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:02:18.410" end="00:02:21.690">
        <tt:span style="textWhite">Aber Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">braucht noch mehr Investoren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:02:22.290" end="00:02:25.010">
        <tt:span style="textWhite">Diese Frau</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist Expertin für Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:25.730" end="00:02:29.490">
        <tt:span style="textWhite">Sie sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Deutschland liegt mitten in Europa.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:29.970" end="00:02:32.890">
        <tt:span style="textWhite">Und es gibt viele Forscher</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:33.210" end="00:02:35.330">
        <tt:span style="textWhite">Das finden Investoren gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:35.570" end="00:02:40.690">
        <tt:span style="textWhite">Aber in Deutschland ist Energie</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr teuer und die Steuern sind hoch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:40.730" end="00:02:42.970">
        <tt:span style="textWhite">Das mögen Investoren nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:43.610" end="00:02:46.490">
        <tt:span style="textWhite">Deshalb muss die Bundesregierung</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:46.530" end="00:02:49.930">
        <tt:span style="textWhite">neue, bessere Regeln</tt:span>
        <tt:br />
        <tt:span style="textWhite">zum Beispiel für Steuern machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:49.970" end="00:02:53.130">
        <tt:span style="textWhite">Dann kommen mehr Investoren</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:53.970" end="00:02:56.490">
        <tt:span style="textWhite">Und der Chef von Nvidia sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:56.730" end="00:03:01.530">
        <tt:span style="textWhite">die Menschen in Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">können viel, fangt mit der Arbeit an.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:03:03.450" end="00:03:08.090">
        <tt:span style="textWhite">Deutschland will den Investoren</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei dem Treffen in Berlin zeigen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:03:08.370" end="00:03:11.450">
        <tt:span style="textWhite">es ist gut,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wenn ihr nach Deutschland kommt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:03:12.290" end="00:03:14.650">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:03:19.050" end="00:03:22.610">
        <tt:span style="textWhite">Wenn auf Reisen der Bus,</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Bahn oder das Flugzeug</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:03:23.170" end="00:03:28.250">
        <tt:span style="textWhite">zu spät kommen oder ausfallen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dann haben Reisende Rechte.</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:03:28.610" end="00:03:32.690">
        <tt:span style="textWhite">Sie bekommen zum Beispiel Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">für das Ticket zurück.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:33.530" end="00:03:38.090">
        <tt:span style="textWhite">Bislang ist es aber oft schwierig,</tt:span>
        <tt:br />
        <tt:span style="textWhite">an das Geld zu kommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:39.210" end="00:03:44.290">
        <tt:span style="textWhite">Manchmal muss man viel schreiben</tt:span>
        <tt:br />
        <tt:span style="textWhite">an verschiedene Behörden oder Firmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:45.170" end="00:03:47.250">
        <tt:span style="textWhite">Die EU will das ändern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:47.690" end="00:03:51.810">
        <tt:span style="textWhite">Es soll einfacher werden,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Geld zurückzubekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:52.370" end="00:03:57.050">
        <tt:span style="textWhite">Und es soll in der ganzen EU</tt:span>
        <tt:br />
        <tt:span style="textWhite">nur einen Antrag dafür geben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:57.610" end="00:04:02.650">
        <tt:span style="textWhite">Er soll einfach zu verstehen</tt:span>
        <tt:br />
        <tt:span style="textWhite">und in allen Ländern gleich sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:04:03.170" end="00:04:07.130">
        <tt:span style="textWhite">Das Parlament von der EU</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat dafür gestimmt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:04:07.970" end="00:04:11.410">
        <tt:span style="textWhite">Die EU-Länder</tt:span>
        <tt:br />
        <tt:span style="textWhite">müssen aber noch darüber abstimmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:04:14.210" end="00:04:16.410">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:04:21.970" end="00:04:26.890">
        <tt:span style="textWhite">Vor 65 Jahren brauchte</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Bundesrepublik Deutschland</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:04:26.930" end="00:04:28.890">
        <tt:span style="textWhite">sehr viele Arbeiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:04:29.370" end="00:04:33.570">
        <tt:span style="textWhite">Die Bundesrepublik</tt:span>
        <tt:br />
        <tt:span style="textWhite">war im Westen von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:04:34.370" end="00:04:38.010">
        <tt:span style="textWhite">Die Wirtschaft</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist damals stark gewachsen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:04:38.530" end="00:04:40.730">
        <tt:span style="textWhite">Und es gab viel Arbeit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:04:41.410" end="00:04:44.290">
        <tt:span style="textWhite">Es gab aber zu wenige Arbeiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:04:45.090" end="00:04:50.730">
        <tt:span style="textWhite">Deshalb hat die Bundesrepublik</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Türkei einen Vertrag gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:04:51.490" end="00:04:56.210">
        <tt:span style="textWhite">In der Türkei waren nämlich</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Menschen ohne Arbeit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:57.170" end="00:05:01.730">
        <tt:span style="textWhite">Viele von ihnen sind deshalb</tt:span>
        <tt:br />
        <tt:span style="textWhite">in die Bundesrepublik gekommen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:05:02.050" end="00:05:03.410">
        <tt:span style="textWhite">wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:05:04.330" end="00:05:09.010">
        <tt:span style="textWhite">Sie haben dort gearbeitet</tt:span>
        <tt:br />
        <tt:span style="textWhite">und damit der Wirtschaft geholfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:05:09.850" end="00:05:14.890">
        <tt:span style="textWhite">Sie haben Geld verdient</tt:span>
        <tt:br />
        <tt:span style="textWhite">und davon etwas nach Hause geschickt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:05:15.770" end="00:05:19.330">
        <tt:span style="textWhite">Und damit den Menschen in der Türkei</tt:span>
        <tt:br />
        <tt:span style="textWhite">geholfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:05:19.810" end="00:05:21.730">
        <tt:span style="textWhite">Jetzt zeigen wir einen Film dazu.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:05:22.410" end="00:05:24.810">
        <tt:span style="textWhite">Diese alten Aufnahmen zeigen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:05:25.370" end="00:05:28.730">
        <tt:span style="textWhite">viele türkische Arbeiter</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind damals gekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:05:29.130" end="00:05:33.890">
        <tt:span style="textWhite">Die Bundesrepublik brauchte dringend</tt:span>
        <tt:br />
        <tt:span style="textWhite">Arbeiter für Fabriken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:05:34.370" end="00:05:38.530">
        <tt:span style="textWhite">Eigentlich sollten die Arbeiter</tt:span>
        <tt:br />
        <tt:span style="textWhite">nur wenige Jahre bleiben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:05:38.970" end="00:05:41.930">
        <tt:span style="textWhite">Deshalb nannte man sie Gastarbeiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:05:42.890" end="00:05:44.450">
        <tt:span style="textWhite">Viele sind aber geblieben</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:05:44.970" end="00:05:48.410">
        <tt:span style="textWhite">und haben auch die Familie</tt:span>
        <tt:br />
        <tt:span style="textWhite">aus der Türkei geholt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:05:48.490" end="00:05:51.850">
        <tt:span style="textWhite">So wie der Opa von Ömer Kocak.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:52.330" end="00:05:56.650">
        <tt:span style="textWhite">Ömer Kocak</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat eine eigene Firma in Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:57.130" end="00:06:00.010">
        <tt:span style="textWhite">Sie bekommt gerade ein neues Gebäude.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:06:00.730" end="00:06:05.730">
        <tt:span style="textWhite">Ömer Kocak sagt, ich möchte,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dass hier alles ordentlich ist.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:06:05.850" end="00:06:08.570">
        <tt:span style="textWhite">Und ich möchte gute Arbeit machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:06:08.730" end="00:06:10.330">
        <tt:span style="textWhite">Ich bin sehr deutsch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:06:10.930" end="00:06:15.570">
        <tt:span style="textWhite">Die Firma putzt, räumt auf</tt:span>
        <tt:br />
        <tt:span style="textWhite">und hält Gärten in Ordnung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:06:16.010" end="00:06:21.810">
        <tt:span style="textWhite">Als Ömer Kocak Kind war, hat er</tt:span>
        <tt:br />
        <tt:span style="textWhite">seiner Mutter beim Putzen geholfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:06:23.410" end="00:06:24.690">
        <tt:span style="textWhite">Die Mutter sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:06:25.010" end="00:06:29.010">
        <tt:span style="textWhite">wir haben sehr früh morgens</tt:span>
        <tt:br />
        <tt:span style="textWhite">angefangen zu putzen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:06:29.090" end="00:06:31.930">
        <tt:span style="textWhite">Danach ist Ömer zur Schule gegangen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:06:32.850" end="00:06:37.090">
        <tt:span style="textWhite">Der Opa von Ömer Kocak</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist vor 60 Jahren</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:06:37.130" end="00:06:39.330">
        <tt:span style="textWhite">in die Bundesrepublik bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:06:39.690" end="00:06:42.770">
        <tt:span style="textWhite">Einen Sprachkurs gab es damals nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:06:44.090" end="00:06:47.450">
        <tt:span style="textWhite">Die Mutter sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">er hatte es sehr schwer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:06:47.690" end="00:06:49.330">
        <tt:span style="textWhite">Er konnte kein Deutsch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:06:49.810" end="00:06:53.330">
        <tt:span style="textWhite">Es war schwierig beim Einkaufen</tt:span>
        <tt:br />
        <tt:span style="textWhite">oder beim Arzt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:06:53.570" end="00:06:55.810">
        <tt:span style="textWhite">Er hat die Sprache nicht verstanden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:06:55.850" end="00:06:58.210">
        <tt:span style="textWhite">Am Anfang war es sehr schwer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:06:59.330" end="00:07:01.530">
        <tt:span style="textWhite">Der Opa war Gastarbeiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:07:02.250" end="00:07:06.570">
        <tt:span style="textWhite">Sein Enkel Ömer Kocak</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat eine große Firma.</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:07:07.130" end="00:07:09.690">
        <tt:span style="textWhite">Vieles ist anders als früher.</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:07:11.490" end="00:07:12.970">
        <tt:span style="textWhite">Ömer Kocak sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:07:13.370" end="00:07:17.250">
        <tt:span style="textWhite">früher sind wir in den Sommerferien</tt:span>
        <tt:br />
        <tt:span style="textWhite">in die Türkei gefahren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:07:17.290" end="00:07:18.450">
        <tt:span style="textWhite">Das war super.</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:07:18.650" end="00:07:21.810">
        <tt:span style="textWhite">Aber meine Kinder</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen dort nicht mehr hin.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:07:22.290" end="00:07:27.370">
        <tt:span style="textWhite">Zur Erinnerung an die Türkei</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat Ömer Kocak einen Baum gepflanzt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:07:27.410" end="00:07:29.610">
        <tt:span style="textWhite">einen türkischen Olivenbaum.</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:07:31.770" end="00:07:33.650">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:07:39.210" end="00:07:42.850">
        <tt:span style="textWhite">In Deutschland fühlen sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Menschen einsam.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:07:43.090" end="00:07:45.010">
        <tt:span style="textWhite">Es sind oft junge Menschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:07:45.490" end="00:07:47.170">
        <tt:span style="textWhite">Sie sind dann traurig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:07:47.610" end="00:07:50.770">
        <tt:span style="textWhite">Das kann gefährlich</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Gesundheit sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:07:51.490" end="00:07:55.970">
        <tt:span style="textWhite">Es gibt aber verschiedene Projekte</tt:span>
        <tt:br />
        <tt:span style="textWhite">für einsame Menschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:07:56.850" end="00:08:01.890">
        <tt:span style="textWhite">Zum Beispiel gemeinsame Spaziergänge,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:08:02.770" end="00:08:06.810">
        <tt:span style="textWhite">Bei diesen Spaziergängen</tt:span>
        <tt:br />
        <tt:span style="textWhite">lernen sich die Menschen kennen</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:08:07.370" end="00:08:09.330">
        <tt:span style="textWhite">und werden vielleicht Freunde.</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:08:10.090" end="00:08:15.050">
        <tt:span style="textWhite">Es gibt diese Spaziergänge</tt:span>
        <tt:br />
        <tt:span style="textWhite">zum Beispiel in der Stadt Leipzig</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:08:15.090" end="00:08:17.130">
        <tt:span style="textWhite">im Osten von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:08:17.610" end="00:08:19.970">
        <tt:span style="textWhite">Dazu zeigen wir jetzt einen Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:08:20.970" end="00:08:24.610">
        <tt:span style="textWhite">Pascal Oetken</tt:span>
        <tt:br />
        <tt:span style="textWhite">organisiert die Spaziergänge</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:08:24.650" end="00:08:26.850">
        <tt:span style="textWhite">und begrüßt die Menschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:08:26.890" end="00:08:29.370">
        <tt:span style="textWhite">Sie haben unterschiedliche Gründe,</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:08:29.810" end="00:08:32.610">
        <tt:span style="textWhite">warum sie</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei dem Spaziergang mitmachen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:08:32.970" end="00:08:36.650">
        <tt:span style="textWhite">Diese Frau sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">ich will neue Menschen kennenlernen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub117" style="textCenter" region="bottom" begin="00:08:36.690" end="00:08:40.490">
        <tt:span style="textWhite">Dieser Mann sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">es ist gut für schüchterne Menschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub118" style="textCenter" region="bottom" begin="00:08:41.090" end="00:08:42.610">
        <tt:span style="textWhite">Und dieser Mann sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub119" style="textCenter" region="bottom" begin="00:08:42.650" end="00:08:46.690">
        <tt:span style="textWhite">ich möchte in der Natur sein</tt:span>
        <tt:br />
        <tt:span style="textWhite">und nicht immer am Handy.</tt:span>
      </tt:p>
      <tt:p xml:id="sub120" style="textCenter" region="bottom" begin="00:08:47.490" end="00:08:51.650">
        <tt:span style="textWhite">Einmal in der Woche treffen sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Menschen zum Spaziergang,</tt:span>
      </tt:p>
      <tt:p xml:id="sub121" style="textCenter" region="bottom" begin="00:08:51.850" end="00:08:53.770">
        <tt:span style="textWhite">auch bei schlechtem Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub122" style="textCenter" region="bottom" begin="00:08:54.010" end="00:08:57.290">
        <tt:span style="textWhite">Sie gehen jedes Mal</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen anderen Weg.</tt:span>
      </tt:p>
      <tt:p xml:id="sub123" style="textCenter" region="bottom" begin="00:08:57.810" end="00:09:00.770">
        <tt:span style="textWhite">Vor allem jüngere Menschen gehen mit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub124" style="textCenter" region="bottom" begin="00:09:01.010" end="00:09:03.370">
        <tt:span style="textWhite">Sie fühlen sich oft einsam.</tt:span>
      </tt:p>
      <tt:p xml:id="sub125" style="textCenter" region="bottom" begin="00:09:04.050" end="00:09:07.490">
        <tt:span style="textWhite">Manche haben hier schon</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen Partner gefunden</tt:span>
      </tt:p>
      <tt:p xml:id="sub126" style="textCenter" region="bottom" begin="00:09:07.770" end="00:09:09.290">
        <tt:span style="textWhite">oder neue Freunde.</tt:span>
      </tt:p>
      <tt:p xml:id="sub127" style="textCenter" region="bottom" begin="00:09:09.890" end="00:09:15.850">
        <tt:span style="textWhite">Pascal Oetken hat nicht gedacht,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dass die Idee so gut ankommt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub128" style="textCenter" region="bottom" begin="00:09:16.690" end="00:09:20.210">
        <tt:span style="textWhite">Er sagt, manche Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">bleiben immer zu Hause.</tt:span>
      </tt:p>
      <tt:p xml:id="sub129" style="textCenter" region="bottom" begin="00:09:20.410" end="00:09:22.130">
        <tt:span style="textWhite">Sie sind sehr einsam.</tt:span>
      </tt:p>
      <tt:p xml:id="sub130" style="textCenter" region="bottom" begin="00:09:22.410" end="00:09:26.850">
        <tt:span style="textWhite">Wenn solche Menschen zum Spaziergang</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommen und andere treffen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub131" style="textCenter" region="bottom" begin="00:09:27.130" end="00:09:28.570">
        <tt:span style="textWhite">dann freue ich mich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub132" style="textCenter" region="bottom" begin="00:09:29.930" end="00:09:35.290">
        <tt:span style="textWhite">Die Menschen kommen, weil sie sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">vom Partner getrennt haben,</tt:span>
      </tt:p>
      <tt:p xml:id="sub133" style="textCenter" region="bottom" begin="00:09:35.730" end="00:09:40.050">
        <tt:span style="textWhite">umgezogen sind</tt:span>
        <tt:br />
        <tt:span style="textWhite">oder eine neue Arbeit haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub134" style="textCenter" region="bottom" begin="00:09:40.730" end="00:09:44.210">
        <tt:span style="textWhite">Sie können hier</tt:span>
        <tt:br />
        <tt:span style="textWhite">andere Menschen kennenlernen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub135" style="textCenter" region="bottom" begin="00:09:44.690" end="00:09:48.170">
        <tt:span style="textWhite">Solche Spaziergänge</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen Einsamkeit gibt es schon</tt:span>
      </tt:p>
      <tt:p xml:id="sub136" style="textCenter" region="bottom" begin="00:09:48.970" end="00:09:51.610">
        <tt:span style="textWhite">in vielen deutschen Städten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub137" style="textCenter" region="bottom" begin="00:09:53.690" end="00:09:55.810">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub138" style="textCenter" region="bottom" begin="00:10:14.690" end="00:10:16.930">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub139" style="textCenter" region="bottom" begin="00:10:17.530" end="00:10:21.570">
        <tt:span style="textWhite">Es gibt viele Wolken</tt:span>
        <tt:br />
        <tt:span style="textWhite">und es regnet in vielen Regionen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub140" style="textCenter" region="bottom" begin="00:10:21.930" end="00:10:26.570">
        <tt:span style="textWhite">Links im Westen nur manchmal,</tt:span>
        <tt:br />
        <tt:span style="textWhite">rechts im Osten ist es trocken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub141" style="textCenter" region="bottom" begin="00:10:26.850" end="00:10:29.170">
        <tt:span style="textWhite">Es werden 8 bis 18 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub142" style="textCenter" region="bottom" begin="00:10:30.370" end="00:10:33.770">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub143" style="textCenter" region="bottom" begin="00:10:34.090" end="00:10:36.450">
        <tt:span style="textWhite">Tschüss und bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub144" style="textCenter" region="bottom" begin="00:10:40.090" end="00:10:42.330">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
