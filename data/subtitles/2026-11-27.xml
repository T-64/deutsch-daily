      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:02.800" end="00:00:03.800">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:03.920" end="00:00:06.640">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:10.360" end="00:00:13.360">
        <tt:span style="textWhite">Willkommen zur tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:13.640" end="00:00:15.440">
        <tt:span style="textWhite">Ich bin Michail Paweletz.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:16.020" end="00:00:18.300">
        <tt:span style="textWhite">Und das sind unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:37.320" end="00:00:39.400">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:44.160" end="00:00:47.720">
        <tt:span style="textWhite">Die Bundesregierung</tt:span>
        <tt:br />
        <tt:span style="textWhite">plant Änderungen bei der Rente.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:48.600" end="00:00:55.000">
        <tt:span style="textWhite">Die Parteien CDU, CSU und SPD</tt:span>
        <tt:br />
        <tt:span style="textWhite">streiten aber seit Monaten,</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:55.180" end="00:00:57.700">
        <tt:span style="textWhite">wie die Rente geändert werden soll.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:58.540" end="00:01:01.780">
        <tt:span style="textWhite">Das Ministerium</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Arbeit und Soziales</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:01:01.820" end="00:01:03.660">
        <tt:span style="textWhite">ist für die Rente zuständig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:04.600" end="00:01:08.160">
        <tt:span style="textWhite">Es hat jetzt einen Plan</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Änderungen gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:09.240" end="00:01:14.000">
        <tt:span style="textWhite">Die Rente ohne Abzug</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach 45 Jahren Arbeit soll bleiben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:15.400" end="00:01:21.880">
        <tt:span style="textWhite">Wer nach 35 Jahren Arbeit in Rente</tt:span>
        <tt:br />
        <tt:span style="textWhite">gehen will, der bekommt weniger Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:23.160" end="00:01:26.000">
        <tt:span style="textWhite">Und er muss mindestens</tt:span>
        <tt:br />
        <tt:span style="textWhite">64 Jahre alt sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:27.360" end="00:01:31.520">
        <tt:span style="textWhite">Außerdem sollen mehr Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">in die Rentenkasse einzahlen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:31.560" end="00:01:35.020">
        <tt:span style="textWhite">z.B. Minijobber und Politiker.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:37.360" end="00:01:39.560">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:45.600" end="00:01:48.960">
        <tt:span style="textWhite">Der Bundestag ist das Parlament</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:49.920" end="00:01:53.480">
        <tt:span style="textWhite">Die Politiker im Bundestag</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben heute entschieden:</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:54.120" end="00:01:55.480">
        <tt:span style="textWhite">Die Bundesregierung</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:55.520" end="00:01:59.480">
        <tt:span style="textWhite">darf im nächsten Jahr</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Milliarden Euro ausgeben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:02:00.760" end="00:02:04.800">
        <tt:span style="textWhite">Sie darf z.B. viel Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Verteidigung ausgeben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:02:06.000" end="00:02:08.480">
        <tt:span style="textWhite">Der Bundestag hat auch entschieden:</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:02:09.120" end="00:02:12.780">
        <tt:span style="textWhite">Die Regierung darf viele Milliarden</tt:span>
        <tt:br />
        <tt:span style="textWhite">neue Schulden machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:02:13.760" end="00:02:16.760">
        <tt:span style="textWhite">Schulden machen bedeutet:</tt:span>
        <tt:br />
        <tt:span style="textWhite">sich Geld leihen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:17.840" end="00:02:21.840">
        <tt:span style="textWhite">Die Politiker haben lange</tt:span>
        <tt:br />
        <tt:span style="textWhite">über die neuen Schulden gestritten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:22.060" end="00:02:23.740">
        <tt:span style="textWhite">Dazu zeigen wir einen Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:25.200" end="00:02:28.120">
        <tt:span style="textWhite">Hier sieht man</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Politiker im Bundestag.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:28.340" end="00:02:30.500">
        <tt:span style="textWhite">Bundeskanzler Merz ist zufrieden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:30.960" end="00:02:35.560">
        <tt:span style="textWhite">Er sagt: Es hat lange gedauert,</tt:span>
        <tt:br />
        <tt:span style="textWhite">bis wir uns geeinigt haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:36.440" end="00:02:40.640">
        <tt:span style="textWhite">Die Politiker haben z.B.</tt:span>
        <tt:br />
        <tt:span style="textWhite">über die neuen Schulden gestritten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:41.360" end="00:02:45.700">
        <tt:span style="textWhite">Das meiste Geld bekommt das</tt:span>
        <tt:br />
        <tt:span style="textWhite">Ministerium für Arbeit und Soziales.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:46.320" end="00:02:48.040">
        <tt:span style="textWhite">Minister Schweizer sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:48.520" end="00:02:50.680">
        <tt:span style="textWhite">Geld für Rentner und Familien,</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:50.980" end="00:02:54.420">
        <tt:span style="textWhite">für Arbeitslose</tt:span>
        <tt:br />
        <tt:span style="textWhite">und für arme Menschen ist wichtig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:54.920" end="00:02:57.560">
        <tt:span style="textWhite">Sie können dann</tt:span>
        <tt:br />
        <tt:span style="textWhite">ein gutes Leben haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:57.980" end="00:03:01.980">
        <tt:span style="textWhite">Viele Politiker machen sich aber</tt:span>
        <tt:br />
        <tt:span style="textWhite">Sorgen über die Schulden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:03:02.220" end="00:03:05.700">
        <tt:span style="textWhite">Auch Politiker</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Regierungsparteien CDU,</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:03:06.380" end="00:03:09.020">
        <tt:span style="textWhite">CSU und SPD sind skeptisch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:03:09.720" end="00:03:12.080">
        <tt:span style="textWhite">Johannes Winkel von der CDU sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:03:12.760" end="00:03:15.920">
        <tt:span style="textWhite">Die Regierung</tt:span>
        <tt:br />
        <tt:span style="textWhite">muss sich einen Plan überlegen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:16.180" end="00:03:18.900">
        <tt:span style="textWhite">Wie kann sie die Schulden</tt:span>
        <tt:br />
        <tt:span style="textWhite">zurückzahlen?</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:20.240" end="00:03:24.080">
        <tt:span style="textWhite">Auch Experten für Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">kritisieren die vielen Schulden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:24.600" end="00:03:27.120">
        <tt:span style="textWhite">Sie sagen: Deutschland muss sparen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:27.760" end="00:03:30.840">
        <tt:span style="textWhite">Sonst gibt es in der Zukunft</tt:span>
        <tt:br />
        <tt:span style="textWhite">große Probleme.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:32.760" end="00:03:34.960">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:38.240" end="00:03:42.240">
        <tt:span style="textWhite">Auf dem Foto ist eine Fahne</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Sternen im Kreis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:42.500" end="00:03:45.660">
        <tt:span style="textWhite">Die Fahne</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist von der Europäischen Union.</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:46.100" end="00:03:48.260">
        <tt:span style="textWhite">Das kurze Wort ist EU.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:48.980" end="00:03:52.380">
        <tt:span style="textWhite">In der EU</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind viele Länder von Europa.</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:52.700" end="00:03:56.700">
        <tt:span style="textWhite">Die Chefs von den Ländern</tt:span>
        <tt:br />
        <tt:span style="textWhite">streiten gerade über Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:57.020" end="00:03:59.220">
        <tt:span style="textWhite">Sie müssen nämlich entscheiden,</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:59.260" end="00:04:02.820">
        <tt:span style="textWhite">wie viel Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">bekommt die EU in den nächsten Jahren</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:04:02.860" end="00:04:03.900">
        <tt:span style="textWhite">von den Ländern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:04:03.940" end="00:04:07.900">
        <tt:span style="textWhite">Und was soll die EU</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit dem Geld bezahlen?</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:04:08.660" end="00:04:11.500">
        <tt:span style="textWhite">Einige Länder,</tt:span>
        <tt:br />
        <tt:span style="textWhite">so wie Deutschland, sagen:</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:04:11.580" end="00:04:14.380">
        <tt:span style="textWhite">Die EU soll weniger Geld bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:04:14.980" end="00:04:17.020">
        <tt:span style="textWhite">Wir müssen nämlich sparen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:17.620" end="00:04:21.380">
        <tt:span style="textWhite">Andere Länder sagen:</tt:span>
        <tt:br />
        <tt:span style="textWhite">Die EU soll mehr Geld bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:22.020" end="00:04:23.660">
        <tt:span style="textWhite">Deshalb gibt es Streit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:23.980" end="00:04:25.820">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:27.240" end="00:04:31.200">
        <tt:span style="textWhite">Die Chefs von allen EU-Ländern</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben sich in Brüssel getroffen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:32.000" end="00:04:34.200">
        <tt:span style="textWhite">Sie haben zwei Tage verhandelt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:34.560" end="00:04:36.640">
        <tt:span style="textWhite">Wie viel Geld bekommt die EU?</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:37.800" end="00:04:42.360">
        <tt:span style="textWhite">Hier sind die Chefs von den Ländern,</tt:span>
        <tt:br />
        <tt:span style="textWhite">die weniger bezahlen wollen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:42.700" end="00:04:45.420">
        <tt:span style="textWhite">Bundeskanzler Merz ist auch dabei.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:46.400" end="00:04:50.160">
        <tt:span style="textWhite">Merz sagt: Die EU will zu viel Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:50.900" end="00:04:54.020">
        <tt:span style="textWhite">Viele Länder von der EU</tt:span>
        <tt:br />
        <tt:span style="textWhite">müssen aber sparen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:54.680" end="00:04:57.400">
        <tt:span style="textWhite">Sie können nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">so viel Geld bezahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:58.200" end="00:04:59.840">
        <tt:span style="textWhite">Das ist Giorgia Meloni.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:05:00.280" end="00:05:03.080">
        <tt:span style="textWhite">Sie ist Ministerpräsidentin</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Italien.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:05:03.780" end="00:05:07.060">
        <tt:span style="textWhite">Italien bekommt viel Geld von der EU.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:07.920" end="00:05:08.920">
        <tt:span style="textWhite">Meloni sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:09.040" end="00:05:11.400">
        <tt:span style="textWhite">Ich unterschreibe keinen Vertrag,</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:11.520" end="00:05:14.240">
        <tt:span style="textWhite">wenn Italien dann</tt:span>
        <tt:br />
        <tt:span style="textWhite">weniger Geld bekommt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:14.960" end="00:05:17.520">
        <tt:span style="textWhite">Die EU-Länder streiten auch darüber.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:17.960" end="00:05:21.900">
        <tt:span style="textWhite">Was soll die EU in den nächsten</tt:span>
        <tt:br />
        <tt:span style="textWhite">Jahren mit dem Geld bezahlen?</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:22.760" end="00:05:24.680">
        <tt:span style="textWhite">Bundeskanzler Merz fordert,</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:24.820" end="00:05:29.180">
        <tt:span style="textWhite">die EU soll weniger Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Landwirtschaft bezahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:29.840" end="00:05:34.640">
        <tt:span style="textWhite">Sie soll mehr Geld für Verteidigung</tt:span>
        <tt:br />
        <tt:span style="textWhite">und neue Ideen bezahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:35.280" end="00:05:39.200">
        <tt:span style="textWhite">Merz sagt: Europa braucht</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine starke Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:39.820" end="00:05:40.980">
        <tt:span style="textWhite">Das ist wichtig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:41.560" end="00:05:45.200">
        <tt:span style="textWhite">Und Europa braucht</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine starke Verteidigung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:46.260" end="00:05:49.060">
        <tt:span style="textWhite">Das Land Österreich</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat viel Landwirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:49.100" end="00:05:51.700">
        <tt:span style="textWhite">Österreichs Regierungschef sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:05:52.640" end="00:05:56.160">
        <tt:span style="textWhite">Die Landwirtschaft in Europa</tt:span>
        <tt:br />
        <tt:span style="textWhite">muss moderner werden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:05:56.560" end="00:05:58.200">
        <tt:span style="textWhite">Sie braucht dafür Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:06:00.160" end="00:06:03.720">
        <tt:span style="textWhite">Die Länder streiten</tt:span>
        <tt:br />
        <tt:span style="textWhite">auch über Geld für die Ukraine.</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:06:04.140" end="00:06:08.860">
        <tt:span style="textWhite">Merz sagt: Die Ukraine muss sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">weiter gegen Russland verteidigen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:06:09.360" end="00:06:11.720">
        <tt:span style="textWhite">Die EU muss der Ukraine helfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:06:13.400" end="00:06:17.420">
        <tt:span style="textWhite">Einige EU-Länder wollen der Ukraine</tt:span>
        <tt:br />
        <tt:span style="textWhite">aber weniger Geld geben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:06:18.080" end="00:06:20.560">
        <tt:span style="textWhite">Der Regierungschef</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Tschechien sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:06:20.680" end="00:06:23.120">
        <tt:span style="textWhite">In den Verträgen von der EU steht,</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:06:23.280" end="00:06:26.120">
        <tt:span style="textWhite">die Länder</tt:span>
        <tt:br />
        <tt:span style="textWhite">unterstützen sich gegenseitig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:06:26.240" end="00:06:28.880">
        <tt:span style="textWhite">Die Ukraine ist aber nicht in der EU.</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:06:29.560" end="00:06:34.000">
        <tt:span style="textWhite">Jedes Land soll entscheiden:</tt:span>
        <tt:br />
        <tt:span style="textWhite">Wie viel Geld gibt es der Ukraine.</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:06:34.640" end="00:06:39.060">
        <tt:span style="textWhite">Die Chefs von den Ländern haben</tt:span>
        <tt:br />
        <tt:span style="textWhite">ihr Treffen ohne Ergebnis beendet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:06:39.600" end="00:06:42.160">
        <tt:span style="textWhite">Im Dezember treffen sie sich wieder.</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:06:43.600" end="00:06:45.640">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:06:49.680" end="00:06:53.200">
        <tt:span style="textWhite">Die Zugspitze</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist der höchste Berg in Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:06:53.440" end="00:06:57.360">
        <tt:span style="textWhite">Er ist ganz unten in Bayern</tt:span>
        <tt:br />
        <tt:span style="textWhite">an der Grenze zu Österreich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:06:58.160" end="00:07:01.560">
        <tt:span style="textWhite">Auf der Zugspitze</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat jetzt die Skisaison begonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:07:01.740" end="00:07:03.660">
        <tt:span style="textWhite">Dazu kommt ein kurzer Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:07:04.820" end="00:07:06.100">
        <tt:span style="textWhite">Seilbahnen wie diese</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:07:06.140" end="00:07:10.380">
        <tt:span style="textWhite">bringen die ersten Skifahrer</tt:span>
        <tt:br />
        <tt:span style="textWhite">und Snowboardfahrer auf den Berg.</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:07:10.700" end="00:07:12.580">
        <tt:span style="textWhite">Die Menschen haben Glück.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:07:12.980" end="00:07:15.900">
        <tt:span style="textWhite">Es gibt viel Schnee</tt:span>
        <tt:br />
        <tt:span style="textWhite">und die Sonne scheint.</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:07:16.260" end="00:07:19.740">
        <tt:span style="textWhite">Die Zugspitze</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist das erste offene Skigebiet</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:07:19.780" end="00:07:22.020">
        <tt:span style="textWhite">in Deutschland in diesem Winter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:07:22.560" end="00:07:27.200">
        <tt:span style="textWhite">In den nächsten Wochen wollen auch</tt:span>
        <tt:br />
        <tt:span style="textWhite">alle anderen Skigebiete öffnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:07:28.320" end="00:07:30.680">
        <tt:span style="textWhite">Und das waren unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:07:46.380" end="00:07:48.620">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:07:50.300" end="00:07:53.660">
        <tt:span style="textWhite">Erst mal ist es</tt:span>
        <tt:br />
        <tt:span style="textWhite">teils sonnig und teils neblig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:07:54.640" end="00:07:56.480">
        <tt:span style="textWhite">Später scheint die Sonne mehr.</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:07:56.640" end="00:07:59.440">
        <tt:span style="textWhite">Es werden</tt:span>
        <tt:br />
        <tt:span style="textWhite">minus vier bis plus vier Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:08:01.320" end="00:08:04.240">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub117" style="textCenter" region="bottom" begin="00:08:04.820" end="00:08:07.140">
        <tt:span style="textWhite">Meldungen und das Video</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Sendung</tt:span>
      </tt:p>
      <tt:p xml:id="sub118" style="textCenter" region="bottom" begin="00:08:07.180" end="00:08:09.300">
        <tt:span style="textWhite">gibt es jetzt auch bei WhatsApp.</tt:span>
      </tt:p>
      <tt:p xml:id="sub119" style="textCenter" region="bottom" begin="00:08:09.660" end="00:08:12.300">
        <tt:span style="textWhite">Sie finden den Kanal</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der tagesschau</tt:span>
      </tt:p>
      <tt:p xml:id="sub120" style="textCenter" region="bottom" begin="00:08:12.340" end="00:08:18.180">
        <tt:span style="textWhite">in einfacher Sprache</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei tagesschau.de/einfach</tt:span>
      </tt:p>
      <tt:p xml:id="sub121" style="textCenter" region="bottom" begin="00:08:19.400" end="00:08:21.560">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub122" style="textCenter" region="bottom" begin="00:08:30.600" end="00:08:32.760">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
