      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:01.710" end="00:00:02.710">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:09.200" end="00:00:12.120">
        <tt:span style="textWhite">Willkommen zur tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:12.200" end="00:00:15.440">
        <tt:span style="textWhite">Ich bin Susanne Holst</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:31.000" end="00:00:33.080">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:38.110" end="00:00:40.750">
        <tt:span style="textWhite">In der Ukraine ist schon lange Krieg.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:41.030" end="00:00:46.070">
        <tt:span style="textWhite">Das Nachbarland Russland greift</tt:span>
        <tt:br />
        <tt:span style="textWhite">immer wieder z.B. mit Raketen an.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:46.280" end="00:00:49.120">
        <tt:span style="textWhite">Viele Menschen sind in dem Krieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">schon gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:49.320" end="00:00:52.840">
        <tt:span style="textWhite">Viele Häuser wurden zerstört,</tt:span>
        <tt:br />
        <tt:span style="textWhite">so wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:53.230" end="00:00:57.390">
        <tt:span style="textWhite">Es hat früher schon Versuche gegeben,</tt:span>
        <tt:br />
        <tt:span style="textWhite">den Krieg zu beenden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:57.830" end="00:00:59.990">
        <tt:span style="textWhite">Dazu wurden Gespräche geführt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:01:00.480" end="00:01:01.880">
        <tt:span style="textWhite">Jetzt gibt es wieder</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:01.960" end="00:01:06.200">
        <tt:span style="textWhite">neue Gespräche über einen Frieden</tt:span>
        <tt:br />
        <tt:span style="textWhite">zwischen Russland und der Ukraine.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:07.120" end="00:01:08.760">
        <tt:span style="textWhite">Die USA sind auch dabei</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:08.800" end="00:01:12.710">
        <tt:span style="textWhite">und wollen bei einer Lösung</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Frieden helfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:13.880" end="00:01:18.400">
        <tt:span style="textWhite">Obwohl es die Gespräche für Frieden</tt:span>
        <tt:br />
        <tt:span style="textWhite">gibt, geht der Krieg weiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:19.270" end="00:01:20.510">
        <tt:span style="textWhite">Wie das für Kinder</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:20.550" end="00:01:25.270">
        <tt:span style="textWhite">in einem Kindergarten in der Ukraine</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist, zeigen wir in einem Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:26.830" end="00:01:31.070">
        <tt:span style="textWhite">Sie spielen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">sie malen und sie essen zusammen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:31.110" end="00:01:35.030">
        <tt:span style="textWhite">Machen das, was Kinder</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Kindergarten so machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:35.670" end="00:01:38.950">
        <tt:span style="textWhite">Doch etwas ist hier im Kindergarten</tt:span>
        <tt:br />
        <tt:span style="textWhite">in der Stadt Sumi</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:38.990" end="00:01:40.630">
        <tt:span style="textWhite">in der Ukraine anders.</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:41.310" end="00:01:43.830">
        <tt:span style="textWhite">Die Kinder</tt:span>
        <tt:br />
        <tt:span style="textWhite">machen das alles im Keller.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:43.870" end="00:01:48.710">
        <tt:span style="textWhite">Oben im Haupthaus vom Kindergarten</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist das nämlich zu gefährlich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:48.950" end="00:01:52.350">
        <tt:span style="textWhite">In Sumi schlagen oft</tt:span>
        <tt:br />
        <tt:span style="textWhite">Raketen aus Russland ein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:01:52.710" end="00:01:56.790">
        <tt:span style="textWhite">Die Fenster vom Kindergarten sind</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei einem Angriff kaputtgegangen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:01:57.520" end="00:01:59.120">
        <tt:span style="textWhite">Die Kindergärtnerin sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:01:59.280" end="00:02:03.320">
        <tt:span style="textWhite">Vor dem Krieg haben die Kinder</tt:span>
        <tt:br />
        <tt:span style="textWhite">normale Spiele gespielt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:03.400" end="00:02:04.440">
        <tt:span style="textWhite">z.B. Familie.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:04.880" end="00:02:08.600">
        <tt:span style="textWhite">Jetzt spielen sie oft Krieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Soldaten und kämpfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:10.040" end="00:02:12.680">
        <tt:span style="textWhite">Am Mittag werden die Kinder abgeholt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:12.920" end="00:02:17.000">
        <tt:span style="textWhite">Diese Mutter sagt: Mein Sohn</tt:span>
        <tt:br />
        <tt:span style="textWhite">kennt nur das Leben im Krieg.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:17.310" end="00:02:19.830">
        <tt:span style="textWhite">Er hat Angst vor lauten Geräuschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:21.870" end="00:02:24.630">
        <tt:span style="textWhite">Die Kindergartenkinder</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Sumi wünschen sich,</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:24.670" end="00:02:27.470">
        <tt:span style="textWhite">dass sie öfter draußen</tt:span>
        <tt:br />
        <tt:span style="textWhite">spielen können.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:27.520" end="00:02:30.320">
        <tt:span style="textWhite">Und vor allem ein Leben ohne Angst.</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:32.520" end="00:02:34.720">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:38.790" end="00:02:43.190">
        <tt:span style="textWhite">Auf dem Foto ist Gina H.</tt:span>
        <tt:br />
        <tt:span style="textWhite">Sie versteckt ihr Gesicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:43.430" end="00:02:46.710">
        <tt:span style="textWhite">Sie möchte nämlich nicht,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dass man sie erkennt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:46.790" end="00:02:51.910">
        <tt:span style="textWhite">Gina H. ist jetzt von einem Gericht</tt:span>
        <tt:br />
        <tt:span style="textWhite">verurteilt worden, wegen Mordes.</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:52.590" end="00:02:55.230">
        <tt:span style="textWhite">Sie soll für lange Zeit</tt:span>
        <tt:br />
        <tt:span style="textWhite">ins Gefängnis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:55.670" end="00:02:57.590">
        <tt:span style="textWhite">Dazu kommt ein kurzer Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:02:58.430" end="00:03:00.750">
        <tt:span style="textWhite">Die Richter sagen, Gina H.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:00.790" end="00:03:05.110">
        <tt:span style="textWhite">hat vor einem Jahr</tt:span>
        <tt:br />
        <tt:span style="textWhite">den acht Jahre alten Fabian ermordet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:05.750" end="00:03:06.750">
        <tt:span style="textWhite">Bei Güstrow.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:07.110" end="00:03:09.950">
        <tt:span style="textWhite">Das ist ein kleiner Ort</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Norden von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:09.990" end="00:03:13.030">
        <tt:span style="textWhite">Die Richter finden,</tt:span>
        <tt:br />
        <tt:span style="textWhite">es gibt genug Beweise,</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:13.270" end="00:03:15.350">
        <tt:span style="textWhite">dass Gina H. das gemacht hat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:15.870" end="00:03:18.550">
        <tt:span style="textWhite">Gina H. sagt aber: Ich war das nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:19.120" end="00:03:21.640">
        <tt:span style="textWhite">Sie will gegen das Urteil vorgehen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:22.270" end="00:03:24.670">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:29.750" end="00:03:32.470">
        <tt:span style="textWhite">Vor fast 90 Jahren</tt:span>
        <tt:br />
        <tt:span style="textWhite">waren in Deutschland</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:32.510" end="00:03:35.150">
        <tt:span style="textWhite">die Nationalsozialisten an der Macht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:35.510" end="00:03:37.310">
        <tt:span style="textWhite">Der kurze Name ist Nazis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:37.910" end="00:03:39.470">
        <tt:span style="textWhite">Ihr Führer war Hitler.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:40.280" end="00:03:45.280">
        <tt:span style="textWhite">Die Nazis waren gegen viele Menschen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">die aus ihrer Sicht anders waren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:45.550" end="00:03:47.230">
        <tt:span style="textWhite">Z.B. gegen Juden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:03:48.280" end="00:03:52.760">
        <tt:span style="textWhite">In der Nacht</tt:span>
        <tt:br />
        <tt:span style="textWhite">vom 9. auf den 10. November 1938</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:03:53.310" end="00:03:57.870">
        <tt:span style="textWhite">sind die Nazis gegen Juden in</tt:span>
        <tt:br />
        <tt:span style="textWhite">Deutschland mit Gewalt vorgegangen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:03:58.390" end="00:04:03.510">
        <tt:span style="textWhite">Sie haben z.B. Synagogen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Religionshäuser der Juden,</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:03.600" end="00:04:06.110">
        <tt:span style="textWhite">angezündet -</tt:span>
        <tt:br />
        <tt:span style="textWhite">das ist auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:06.710" end="00:04:09.190">
        <tt:span style="textWhite">Oder sie haben Geschäfte</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Juden zerstört.</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:09.230" end="00:04:14.710">
        <tt:span style="textWhite">Kurz danach haben die Nazis</tt:span>
        <tt:br />
        <tt:span style="textWhite">damit angefangen, Juden zu ermorden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:15.630" end="00:04:17.750">
        <tt:span style="textWhite">Millionen Menschen sind gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:18.870" end="00:04:22.750">
        <tt:span style="textWhite">Jetzt wurde an die Gewalt der Nazis</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen Juden erinnert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:22.790" end="00:04:26.630">
        <tt:span style="textWhite">Das ist auf diesem Foto</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Bundespräsident Steinmeier.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:26.990" end="00:04:28.550">
        <tt:span style="textWhite">Steinmeier hat gesagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:28.990" end="00:04:31.550">
        <tt:span style="textWhite">der Hass gegen Juden</tt:span>
        <tt:br />
        <tt:span style="textWhite">darf sich nie wiederholen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:31.590" end="00:04:35.110">
        <tt:span style="textWhite">Die Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">sollen sich Hass entgegenstellen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:37.550" end="00:04:39.750">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:44.110" end="00:04:48.790">
        <tt:span style="textWhite">Einmal einen Superstar wie Shakira</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Foto live erleben,</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:49.270" end="00:04:50.990">
        <tt:span style="textWhite">das wünschen sich viele.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:04:51.230" end="00:04:55.750">
        <tt:span style="textWhite">Doch die Tickets für solche Konzerte</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind oft schnell ausverkauft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:04:55.790" end="00:04:58.670">
        <tt:span style="textWhite">Oder die Tickets sind sehr teuer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:04:59.510" end="00:05:02.430">
        <tt:span style="textWhite">Wenn nämlich Superstars</tt:span>
        <tt:br />
        <tt:span style="textWhite">Konzerte geben,</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:02.470" end="00:05:07.190">
        <tt:span style="textWhite">dann kaufen einige Händler</tt:span>
        <tt:br />
        <tt:span style="textWhite">diese Tickets für den normalen Preis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:07.830" end="00:05:10.630">
        <tt:span style="textWhite">Danach verkaufen sie</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Tickets weiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:10.670" end="00:05:14.030">
        <tt:span style="textWhite">Aber nicht für den Preis,</tt:span>
        <tt:br />
        <tt:span style="textWhite">den sie selbst bezahlt haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:14.070" end="00:05:18.150">
        <tt:span style="textWhite">Sie wollen dann viel mehr Geld,</tt:span>
        <tt:br />
        <tt:span style="textWhite">um ein Geschäft zu machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:19.150" end="00:05:22.470">
        <tt:span style="textWhite">Dagegen will die Frau</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Foto jetzt vorgehen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:22.510" end="00:05:25.430">
        <tt:span style="textWhite">Sie ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">Justizministerin Stefanie Hubig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:25.910" end="00:05:30.190">
        <tt:span style="textWhite">Sie sagt: Wir planen</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen Preisdeckel für Tickets.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:31.040" end="00:05:32.040">
        <tt:span style="textWhite">Das bedeutet:</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:32.280" end="00:05:34.920">
        <tt:span style="textWhite">Wenn man</tt:span>
        <tt:br />
        <tt:span style="textWhite">Tickets weiterverkaufen will,</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:35.040" end="00:05:38.960">
        <tt:span style="textWhite">dann darf man bald nur noch</tt:span>
        <tt:br />
        <tt:span style="textWhite">ein bisschen mehr verlangen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:39.070" end="00:05:40.990">
        <tt:span style="textWhite">als man selber bezahlt hat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:42.560" end="00:05:44.920">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:06:00.070" end="00:06:01.990">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:06:02.870" end="00:06:05.190">
        <tt:span style="textWhite">Viele Wolken, ab und zu Regen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:06:05.480" end="00:06:09.680">
        <tt:span style="textWhite">Im Norden ganz oben und im Süden</tt:span>
        <tt:br />
        <tt:span style="textWhite">ganz unten von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:06:10.030" end="00:06:11.030">
        <tt:span style="textWhite">Meist trocken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:06:11.150" end="00:06:13.390">
        <tt:span style="textWhite">Es werden 3 bis 17 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:06:14.670" end="00:06:17.910">
        <tt:span style="textWhite">Und das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:06:17.950" end="00:06:20.110">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:06:28.440" end="00:06:30.600">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
    </tt:div>
