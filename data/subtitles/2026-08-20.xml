      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:00.000" end="00:00:01.160" />
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:04.200" end="00:00:05.360">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:05.760" end="00:00:08.480">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:11.640" end="00:00:14.600">
        <tt:span style="textWhite">Willkommen zur tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:14.640" end="00:00:18.440">
        <tt:span style="textWhite">Ich bin Susanne Holst</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:33.160" end="00:00:34.960">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:39.720" end="00:00:42.760">
        <tt:span style="textWhite">Viele Menschen in Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">heizen mit Gas.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:42.960" end="00:00:47.080">
        <tt:span style="textWhite">Damit es im nächsten Winter</tt:span>
        <tt:br />
        <tt:span style="textWhite">genug Gas gibt, wird Gas gespeichert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:47.120" end="00:00:48.320">
        <tt:span style="textWhite">Wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:48.800" end="00:00:51.800">
        <tt:span style="textWhite">Zurzeit ist aber</tt:span>
        <tt:br />
        <tt:span style="textWhite">wenig Gas in den Speichern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:00:52.240" end="00:00:55.000">
        <tt:span style="textWhite">Sie sind nämlich nur zur Hälfte voll.</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:00:55.200" end="00:00:58.960">
        <tt:span style="textWhite">Das ist deutlich weniger</tt:span>
        <tt:br />
        <tt:span style="textWhite">als im letzten Jahr im August.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:00:59.360" end="00:01:03.360">
        <tt:span style="textWhite">Der Grund dafür, es gibt</tt:span>
        <tt:br />
        <tt:span style="textWhite">insgesamt weniger Gas zu kaufen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:04.360" end="00:01:06.840">
        <tt:span style="textWhite">Wegen dem Krieg von den USA mit Iran.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:07.800" end="00:01:13.040">
        <tt:span style="textWhite">Die beiden Länder streiten über einen</tt:span>
        <tt:br />
        <tt:span style="textWhite">wichtigen Weg für Schiffe mit Gas.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:13.600" end="00:01:18.360">
        <tt:span style="textWhite">Und wenn es insgesamt weniger Gas</tt:span>
        <tt:br />
        <tt:span style="textWhite">zu kaufen gibt, dann ist Gas teurer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:18.920" end="00:01:23.240">
        <tt:span style="textWhite">Experten sagen, Gas wird im Winter</tt:span>
        <tt:br />
        <tt:span style="textWhite">vielleicht noch teurer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:23.400" end="00:01:27.080">
        <tt:span style="textWhite">Und Kunden müssen dann vielleicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">mehr für Gas bezahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:28.880" end="00:01:31.080">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:35.800" end="00:01:39.240">
        <tt:span style="textWhite">Der DGB fragt einmal im Jahr</tt:span>
        <tt:br />
        <tt:span style="textWhite">Auszubildende.</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:40.160" end="00:01:43.240">
        <tt:span style="textWhite">Wie zufrieden</tt:span>
        <tt:br />
        <tt:span style="textWhite">seid ihr mit eurer Ausbildung?</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:43.440" end="00:01:47.000">
        <tt:span style="textWhite">DGB ist das kurze Wort</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Deutscher Gewerkschaftsbund.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:48.120" end="00:01:50.640">
        <tt:span style="textWhite">Im DGB sind mehrere Gewerkschaften.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:51.480" end="00:01:55.440">
        <tt:span style="textWhite">Sie kümmern sich etwa</tt:span>
        <tt:br />
        <tt:span style="textWhite">um die Rechte von Auszubildenden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:01:55.960" end="00:02:02.360">
        <tt:span style="textWhite">Bei der Umfrage vom DGB kam heraus,</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Auszubildende sind unzufrieden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:02:02.800" end="00:02:06.600">
        <tt:span style="textWhite">Sie sagen, wir haben zu viel Stress</tt:span>
        <tt:br />
        <tt:span style="textWhite">und zu wenig Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:07.960" end="00:02:10.320">
        <tt:span style="textWhite">Und deshalb geht es uns schlecht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:10.880" end="00:02:12.600">
        <tt:span style="textWhite">Im Film zeigen wir jetzt</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:12.640" end="00:02:16.720">
        <tt:span style="textWhite">ein Beispiel aus Baden-Württemberg</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Süden von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:17.640" end="00:02:19.440">
        <tt:span style="textWhite">Das ist Darja Grabow.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:20.560" end="00:02:23.800">
        <tt:span style="textWhite">Sie ist Auszubildende</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei einem Tischler.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:25.040" end="00:02:28.080">
        <tt:span style="textWhite">Sie ist seit zwei Jahren</tt:span>
        <tt:br />
        <tt:span style="textWhite">in der Ausbildung</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:28.400" end="00:02:31.000">
        <tt:span style="textWhite">und verdient 1000 Euro im Monat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:32.200" end="00:02:33.200">
        <tt:span style="textWhite">Sie sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:33.360" end="00:02:37.040">
        <tt:span style="textWhite">Ich muss verschiedene Dinge</tt:span>
        <tt:br />
        <tt:span style="textWhite">zum Leben bezahlen</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:37.080" end="00:02:41.400">
        <tt:span style="textWhite">und ich verdiene weniger,</tt:span>
        <tt:br />
        <tt:span style="textWhite">als manche Menschen denken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:43.200" end="00:02:46.840">
        <tt:span style="textWhite">Viele Auszubildende</tt:span>
        <tt:br />
        <tt:span style="textWhite">klagen über zu wenig Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:47.440" end="00:02:49.520">
        <tt:span style="textWhite">Sie fühlen sich unter Druck.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:50.080" end="00:02:53.840">
        <tt:span style="textWhite">Und jetzt will</tt:span>
        <tt:br />
        <tt:span style="textWhite">das Bundesland Baden-Württemberg</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:53.880" end="00:02:58.880">
        <tt:span style="textWhite">manchen Auszubildenden</tt:span>
        <tt:br />
        <tt:span style="textWhite">weniger Geld für das Wohnen bezahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:59.960" end="00:03:02.080">
        <tt:span style="textWhite">Das findet der DGB falsch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:03:03.440" end="00:03:06.600">
        <tt:span style="textWhite">Nina Krüger</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Gewerkschaften sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:08.120" end="00:03:11.880">
        <tt:span style="textWhite">Wir brauchen mehr Wohnheime</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Auszubildende.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:12.280" end="00:03:14.960">
        <tt:span style="textWhite">Die Zimmer müssen günstig sein,</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:15.200" end="00:03:19.200">
        <tt:span style="textWhite">damit die Auszubildenden</tt:span>
        <tt:br />
        <tt:span style="textWhite">weniger Sorgen wegen Geld haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:21.200" end="00:03:25.480">
        <tt:span style="textWhite">Daniela Eigeldinger hat</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Ausbildung abgebrochen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:26.200" end="00:03:28.200">
        <tt:span style="textWhite">Sie war nämlich unzufrieden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:29.280" end="00:03:33.720">
        <tt:span style="textWhite">Deshalb ist sie</tt:span>
        <tt:br />
        <tt:span style="textWhite">zur Beratung gegangen, bei Lisa Kühn.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:35.000" end="00:03:37.160">
        <tt:span style="textWhite">Daniela Eigeldinger sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:37.640" end="00:03:40.360">
        <tt:span style="textWhite">Ich dachte immer, es ist normal,</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:40.760" end="00:03:43.760">
        <tt:span style="textWhite">dass die Ausbildung</tt:span>
        <tt:br />
        <tt:span style="textWhite">keinen Spaß macht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:44.320" end="00:03:45.960">
        <tt:span style="textWhite">Das ist aber falsch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:46.840" end="00:03:49.360">
        <tt:span style="textWhite">Das hat sie</tt:span>
        <tt:br />
        <tt:span style="textWhite">bei der Beratung gelernt</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:49.480" end="00:03:52.640">
        <tt:span style="textWhite">und sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine andere Ausbildung gesucht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:53.200" end="00:03:57.400">
        <tt:span style="textWhite">So ein Wechsel in der Ausbildung</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist aber nicht immer nötig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:58.120" end="00:04:00.280">
        <tt:span style="textWhite">Reden hilft oft bei Problemen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:04:01.440" end="00:04:03.920">
        <tt:span style="textWhite">Die Beraterin Lisa Kühn sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:04:04.760" end="00:04:08.840">
        <tt:span style="textWhite">auch die Firmen müssen sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">um die Auszubildenden kümmern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:04:09.440" end="00:04:13.400">
        <tt:span style="textWhite">Und zwar die ganze Ausbildung lang,</tt:span>
        <tt:br />
        <tt:span style="textWhite">drei Jahre.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:14.640" end="00:04:19.920">
        <tt:span style="textWhite">Die Firmen sollen die Auszubildenden</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Problemen nicht allein lassen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:21.640" end="00:04:25.800">
        <tt:span style="textWhite">In der Tischlerei</tt:span>
        <tt:br />
        <tt:span style="textWhite">hilft der Chef den Auszubildenden,</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:26.880" end="00:04:29.920">
        <tt:span style="textWhite">damit sie ohne Druck arbeiten können.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:32.120" end="00:04:34.320">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:37.080" end="00:04:39.800">
        <tt:span style="textWhite">In Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">gab es schwere Unwetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:39.920" end="00:04:42.960">
        <tt:span style="textWhite">Es gab starken Sturm und viel Regen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:43.280" end="00:04:46.640">
        <tt:span style="textWhite">Der Sturm hat Bäume umgerissen</tt:span>
        <tt:br />
        <tt:span style="textWhite">und Häuser beschädigt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:46.760" end="00:04:48.040">
        <tt:span style="textWhite">wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:48.080" end="00:04:49.800">
        <tt:span style="textWhite">Eine Frau ist gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:49.960" end="00:04:52.840">
        <tt:span style="textWhite">Die Unwetter</tt:span>
        <tt:br />
        <tt:span style="textWhite">waren in mehreren Bundesländern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:52.960" end="00:04:56.560">
        <tt:span style="textWhite">Im Osten, in der Mitte</tt:span>
        <tt:br />
        <tt:span style="textWhite">und im Süden von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:56.720" end="00:04:59.160">
        <tt:span style="textWhite">Jetzt zeigen wir einen Film dazu.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:04:59.640" end="00:05:03.360">
        <tt:span style="textWhite">Das ist ein Tornado</tt:span>
        <tt:br />
        <tt:span style="textWhite">in dem Bundesland Hessen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:05:03.760" end="00:05:05.840">
        <tt:span style="textWhite">in der Mitte von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:06.240" end="00:05:09.440">
        <tt:span style="textWhite">Ein Tornado ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">ein sehr schneller Sturm.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:10.080" end="00:05:15.480">
        <tt:span style="textWhite">Er hat viel Regen und Hagel gebracht,</tt:span>
        <tt:br />
        <tt:span style="textWhite">also kleine Teile aus Eis.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:17.040" end="00:05:19.880">
        <tt:span style="textWhite">Der Tornado hat</tt:span>
        <tt:br />
        <tt:span style="textWhite">einige Häuser beschädigt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:20.200" end="00:05:23.400">
        <tt:span style="textWhite">In diesen Häusern</tt:span>
        <tt:br />
        <tt:span style="textWhite">kann man jetzt nicht wohnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:24.480" end="00:05:27.360">
        <tt:span style="textWhite">Auch in anderen Teilen</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Deutschland</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:27.400" end="00:05:29.760">
        <tt:span style="textWhite">gab es Unwetter mit viel Regen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:30.160" end="00:05:33.880">
        <tt:span style="textWhite">In dem Bundesland Rheinland-Pfalz,</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Süden von Deutschland,</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:33.960" end="00:05:36.440">
        <tt:span style="textWhite">hat der Sturm Bäume umgestürzt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:37.080" end="00:05:39.120">
        <tt:span style="textWhite">Eine Frau ist gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:39.720" end="00:05:43.320">
        <tt:span style="textWhite">Der Sturm hat</tt:span>
        <tt:br />
        <tt:span style="textWhite">auch mehrere Häuser beschädigt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:43.560" end="00:05:48.000">
        <tt:span style="textWhite">Er hat Wände von Häusern</tt:span>
        <tt:br />
        <tt:span style="textWhite">weggerissen und Möbel zerstört.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:48.400" end="00:05:52.520">
        <tt:span style="textWhite">Die Steine von den Wänden</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben auch Autos zerstört.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:54.760" end="00:05:56.320">
        <tt:span style="textWhite">Dieser Mann sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:05:56.480" end="00:06:00.640">
        <tt:span style="textWhite">Ich habe gesehen, wie Steine</tt:span>
        <tt:br />
        <tt:span style="textWhite">durch die Luft geflogen sind.</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:06:01.520" end="00:06:05.880">
        <tt:span style="textWhite">Das waren Teile von den Wänden</tt:span>
        <tt:br />
        <tt:span style="textWhite">und von den Dächern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:06:06.280" end="00:06:10.080">
        <tt:span style="textWhite">Nach wenigen Minuten</tt:span>
        <tt:br />
        <tt:span style="textWhite">war es dann wieder ruhig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:06:10.400" end="00:06:15.000">
        <tt:span style="textWhite">Aber in dieser kurzen Zeit</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat der Sturm viel zerstört.</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:06:16.680" end="00:06:21.920">
        <tt:span style="textWhite">In vielen Orten war der Strom</tt:span>
        <tt:br />
        <tt:span style="textWhite">wegen dem Unwetter ausgefallen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:06:22.840" end="00:06:27.280">
        <tt:span style="textWhite">In dem Bundesland Brandenburg,</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Osten von Deutschland,</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:06:27.480" end="00:06:29.640">
        <tt:span style="textWhite">gab es auch einen Tornado.</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:06:29.920" end="00:06:33.160">
        <tt:span style="textWhite">Teile von Dächern</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind durch die Luft geflogen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:06:33.320" end="00:06:36.760">
        <tt:span style="textWhite">Ein Baum ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">sogar durch ein Dach gekracht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:06:38.280" end="00:06:40.480">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:06:44.440" end="00:06:47.280">
        <tt:span style="textWhite">Auf dem Foto sind</tt:span>
        <tt:br />
        <tt:span style="textWhite">der britische Prinz Harry</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:06:47.440" end="00:06:49.000">
        <tt:span style="textWhite">und seine Frau Meghan.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:06:49.160" end="00:06:53.560">
        <tt:span style="textWhite">Sie haben sich vor einigen Jahren</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Familie von Harry gestritten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:06:53.760" end="00:06:56.840">
        <tt:span style="textWhite">Vor allem mit dem Vater von Harry,</tt:span>
        <tt:br />
        <tt:span style="textWhite">König Charles,</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:06:56.960" end="00:07:00.040">
        <tt:span style="textWhite">und mit dem Bruder von Harry,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Prinz William.</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:07:00.280" end="00:07:03.640">
        <tt:span style="textWhite">Deshalb haben Harry und Meghan</tt:span>
        <tt:br />
        <tt:span style="textWhite">England verlassen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:07:03.800" end="00:07:07.080">
        <tt:span style="textWhite">Sie sind in die USA gezogen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach Kalifornien.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:07:07.240" end="00:07:09.400">
        <tt:span style="textWhite">Das ist die Heimat von Meghan.</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:07:09.840" end="00:07:11.680">
        <tt:span style="textWhite">Jetzt berichten Zeitungen:</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:07:11.840" end="00:07:15.040">
        <tt:span style="textWhite">Harry und Meghan wollen</tt:span>
        <tt:br />
        <tt:span style="textWhite">zurückkommen nach England.</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:07:15.160" end="00:07:18.520">
        <tt:span style="textWhite">Sie wollen sich vielleicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Familie vertragen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:07:18.560" end="00:07:22.120">
        <tt:span style="textWhite">Sie wollen aber keine Aufgaben</tt:span>
        <tt:br />
        <tt:span style="textWhite">für den König übernehmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:07:23.400" end="00:07:25.760">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:07:41.440" end="00:07:43.360">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:07:43.880" end="00:07:48.720">
        <tt:span style="textWhite">Oben im Norden und links im Westen</tt:span>
        <tt:br />
        <tt:span style="textWhite">manchmal Regen und kurze Gewitter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:07:48.840" end="00:07:52.760">
        <tt:span style="textWhite">In der Mitte und rechts im Osten</tt:span>
        <tt:br />
        <tt:span style="textWhite">trocken und viel Sonne.</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:07:52.920" end="00:07:55.920">
        <tt:span style="textWhite">Unten im Süden starker Regen</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Gewittern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:07:56.200" end="00:07:58.480">
        <tt:span style="textWhite">Achtung, es kann Unwetter geben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:08:03.320" end="00:08:06.160">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:08:06.280" end="00:08:08.280">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:08:12.880" end="00:08:15.040">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
