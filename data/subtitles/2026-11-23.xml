      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:03.000" end="00:00:04.400">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:05.240" end="00:00:07.880">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:10.560" end="00:00:13.480">
        <tt:span style="textWhite">Willkommen zur tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:13.600" end="00:00:17.760">
        <tt:span style="textWhite">Ich bin Michail Paweletz</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:44.120" end="00:00:46.240">
        <tt:span style="textWhite">Und nun zur ersten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:52.760" end="00:00:56.480">
        <tt:span style="textWhite">Jedes Jahr treffen sich</tt:span>
        <tt:br />
        <tt:span style="textWhite">Politiker und Experten,</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:57.640" end="00:01:01.360">
        <tt:span style="textWhite">um bei einer Konferenz</tt:span>
        <tt:br />
        <tt:span style="textWhite">über das Klima zu sprechen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:01:02.880" end="00:01:06.560">
        <tt:span style="textWhite">Klima ist das Wetter</tt:span>
        <tt:br />
        <tt:span style="textWhite">von einem langen Zeitraum.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:01:07.880" end="00:01:11.960">
        <tt:span style="textWhite">In diesem Jahr war</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Klimakonferenz in der Türkei.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:01:13.600" end="00:01:17.000">
        <tt:span style="textWhite">Auf dem Foto</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind Teilnehmer von der Konferenz.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:01:17.600" end="00:01:19.560">
        <tt:span style="textWhite">Am Ende einer Klimakonferenz</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:19.680" end="00:01:23.240">
        <tt:span style="textWhite">steht normalerweise</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine Abschlusserklärung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:24.640" end="00:01:29.800">
        <tt:span style="textWhite">Das ist ein Vertrag, in dem steht,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wie wollen wir das Klima schützen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:32.000" end="00:01:35.760">
        <tt:span style="textWhite">In diesem Jahr gibt es</tt:span>
        <tt:br />
        <tt:span style="textWhite">aber keine Abschlusserklärung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:36.280" end="00:01:37.480">
        <tt:span style="textWhite">Warum?</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:37.760" end="00:01:40.160">
        <tt:span style="textWhite">Dazu zeigen wir jetzt einen Film:</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:41.080" end="00:01:43.680">
        <tt:span style="textWhite">Politiker und Experten</tt:span>
        <tt:br />
        <tt:span style="textWhite">aus vielen Ländern</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:43.760" end="00:01:46.920">
        <tt:span style="textWhite">haben in der Stadt Antalya</tt:span>
        <tt:br />
        <tt:span style="textWhite">zwei Wochen verhandelt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:47.080" end="00:01:50.640">
        <tt:span style="textWhite">Es ging um die Frage,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wie schaffen es alle Länder zusammen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:50.760" end="00:01:53.520">
        <tt:span style="textWhite">dass es nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">noch wärmer auf der Erde wird.</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:53.800" end="00:01:55.160">
        <tt:span style="textWhite">Um das zu erreichen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:55.320" end="00:01:57.960">
        <tt:span style="textWhite">müssen die Länder</tt:span>
        <tt:br />
        <tt:span style="textWhite">weniger CO2 produzieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:58.240" end="00:01:59.600">
        <tt:span style="textWhite">CO2 ist ein Gas.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:02:00.000" end="00:02:02.560">
        <tt:span style="textWhite">Es entsteht</tt:span>
        <tt:br />
        <tt:span style="textWhite">zum Beispiel beim Autofahren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:02:02.680" end="00:02:05.840">
        <tt:span style="textWhite">Oder wenn die Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Kohle oder Öl heizen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:02:06.000" end="00:02:09.160">
        <tt:span style="textWhite">Gibt es zu viel CO2,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wird es auf der Erde wärmer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:09.320" end="00:02:10.880">
        <tt:span style="textWhite">Dann gibt es Waldbrände,</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:11.000" end="00:02:13.320">
        <tt:span style="textWhite">aber auch Stürme</tt:span>
        <tt:br />
        <tt:span style="textWhite">und Überschwemmungen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:13.400" end="00:02:16.440">
        <tt:span style="textWhite">Der deutsche Minister für Klima,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Schneider, sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:16.520" end="00:02:19.000">
        <tt:span style="textWhite">Viele Länder</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen das Klima schützen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:19.160" end="00:02:20.400">
        <tt:span style="textWhite">Wir auch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:20.640" end="00:02:24.440">
        <tt:span style="textWhite">Aber einige Länder verdienen</tt:span>
        <tt:br />
        <tt:span style="textWhite">noch viel Geld mit Öl und Gas.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:24.800" end="00:02:28.400">
        <tt:span style="textWhite">Diese Länder sind nicht bereit,</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf das Geld zu verzichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:28.800" end="00:02:31.240">
        <tt:span style="textWhite">Es geht um Länder wie Saudi-Arabien.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:31.360" end="00:02:34.640">
        <tt:span style="textWhite">Sie wollten nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">in die Abschlusserklärung schreiben:</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:34.760" end="00:02:37.600">
        <tt:span style="textWhite">Wir hören auf mit Kohle, Öl und Gas.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:38.680" end="00:02:42.080">
        <tt:span style="textWhite">Dieser Politiker</tt:span>
        <tt:br />
        <tt:span style="textWhite">kümmert sich bei der EU um das Klima.</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:42.200" end="00:02:43.400">
        <tt:span style="textWhite">Er sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:43.480" end="00:02:47.640">
        <tt:span style="textWhite">Wir haben es leider nicht geschafft,</tt:span>
        <tt:br />
        <tt:span style="textWhite">die anderen Länder zu überzeugen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:47.760" end="00:02:50.320">
        <tt:span style="textWhite">Wir müssen aufhören</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Kohle, Öl und Gas.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:50.840" end="00:02:52.000">
        <tt:span style="textWhite">Deshalb gibt es</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:02:52.120" end="00:02:55.040">
        <tt:span style="textWhite">keine Abschlusserklärung</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Klimakonferenz.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:02:55.280" end="00:02:58.320">
        <tt:span style="textWhite">Viele Länder</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen trotzdem das Klima schützen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:02:58.400" end="00:02:59.600">
        <tt:span style="textWhite">Zum Beispiel</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:02:59.720" end="00:03:03.160">
        <tt:span style="textWhite">indem sie Strom mit Windkraft</tt:span>
        <tt:br />
        <tt:span style="textWhite">und Solaranlagen machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:04.840" end="00:03:07.040">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:11.480" end="00:03:15.600">
        <tt:span style="textWhite">An vielen Schulen in Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">gab es heute große Aufregung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:16.600" end="00:03:18.920">
        <tt:span style="textWhite">Auch an der Schule auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:19.520" end="00:03:21.720">
        <tt:span style="textWhite">Sie ist in der Stadt Leipzig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:22.560" end="00:03:26.080">
        <tt:span style="textWhite">Viele Schulen haben am Morgen</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine E-Mail bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:27.000" end="00:03:30.840">
        <tt:span style="textWhite">In der E-Mail wurden die Schulen</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit einer Bombe bedroht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:31.760" end="00:03:34.160">
        <tt:span style="textWhite">Manche Schulen riefen die Polizei.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:35.120" end="00:03:36.360">
        <tt:span style="textWhite">Die Polizei sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:36.680" end="00:03:38.960">
        <tt:span style="textWhite">Es gibt keine direkte Bedrohung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:39.840" end="00:03:41.560">
        <tt:span style="textWhite">Trotzdem wurden die Kinder</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:41.680" end="00:03:44.200">
        <tt:span style="textWhite">an manchen Schulen</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach Hause geschickt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:03:44.520" end="00:03:46.160">
        <tt:span style="textWhite">Der Unterricht fiel aus.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:03:46.720" end="00:03:49.600">
        <tt:span style="textWhite">Die Polizei</tt:span>
        <tt:br />
        <tt:span style="textWhite">sucht jetzt nach dem Täter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:03:51.720" end="00:03:53.760">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:03:57.800" end="00:03:59.720">
        <tt:span style="textWhite">Auf dem Foto ist die Erde.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:00.200" end="00:04:02.240">
        <tt:span style="textWhite">Aufgenommen aus dem Weltraum.</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:03.000" end="00:04:05.680">
        <tt:span style="textWhite">Das Foto hat ein Satellit gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:07.040" end="00:04:10.760">
        <tt:span style="textWhite">Satelliten sind Geräte,</tt:span>
        <tt:br />
        <tt:span style="textWhite">die im Weltall herumfliegen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:11.680" end="00:04:15.040">
        <tt:span style="textWhite">Sie sammeln Daten</tt:span>
        <tt:br />
        <tt:span style="textWhite">und schicken sie zur Erde.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:16.160" end="00:04:19.200">
        <tt:span style="textWhite">Satelliten</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind wichtig für Flugzeuge,</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:19.720" end="00:04:23.520">
        <tt:span style="textWhite">für das Militär</tt:span>
        <tt:br />
        <tt:span style="textWhite">oder um das Wetter vorherzusagen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:25.040" end="00:04:27.720">
        <tt:span style="textWhite">Journalisten</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben jetzt herausgefunden,</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:28.520" end="00:04:33.480">
        <tt:span style="textWhite">Russland arbeitet an einer Waffe,</tt:span>
        <tt:br />
        <tt:span style="textWhite">die viele Satelliten zerstören kann.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:35.480" end="00:04:38.640">
        <tt:span style="textWhite">Und zwar</tt:span>
        <tt:br />
        <tt:span style="textWhite">an einer Atombombe im Weltraum.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:40.360" end="00:04:43.680">
        <tt:span style="textWhite">Eine Atombombe</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist eine sehr starke Bombe.</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:45.440" end="00:04:47.440">
        <tt:span style="textWhite">Dazu zeigen wir einen Film:</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:04:48.560" end="00:04:52.520">
        <tt:span style="textWhite">In diesem Gebäude im Westen</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Deutschland sitzt die Bundeswehr.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:04:52.800" end="00:04:57.280">
        <tt:span style="textWhite">Von hier aus beobachten Soldaten</tt:span>
        <tt:br />
        <tt:span style="textWhite">den Weltraum und die Satelliten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:04:58.120" end="00:05:00.800">
        <tt:span style="textWhite">Rund um die Erde</tt:span>
        <tt:br />
        <tt:span style="textWhite">fliegen viele Satelliten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:01.000" end="00:05:03.240">
        <tt:span style="textWhite">Hier sind sie als Punkte zu sehen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:03.600" end="00:05:05.240">
        <tt:span style="textWhite">Jetzt warnen Behörden:</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:05.360" end="00:05:06.680">
        <tt:span style="textWhite">Russland will bald</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:06.800" end="00:05:09.400">
        <tt:span style="textWhite">eine Atombombe</tt:span>
        <tt:br />
        <tt:span style="textWhite">in den Weltraum bringen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:09.560" end="00:05:11.640">
        <tt:span style="textWhite">Wenn diese Atombombe explodiert,</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:11.760" end="00:05:15.040">
        <tt:span style="textWhite">dann sind viele Satelliten</tt:span>
        <tt:br />
        <tt:span style="textWhite">zerstört und stürzen ab.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:15.760" end="00:05:19.080">
        <tt:span style="textWhite">Viele Dinge im Alltag</tt:span>
        <tt:br />
        <tt:span style="textWhite">funktionieren dann nicht mehr.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:19.360" end="00:05:23.280">
        <tt:span style="textWhite">Navigationsgeräte, Geldautomaten</tt:span>
        <tt:br />
        <tt:span style="textWhite">oder Wettervorhersagen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:24.160" end="00:05:25.640">
        <tt:span style="textWhite">Dieser Experte sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:25.800" end="00:05:29.120">
        <tt:span style="textWhite">Ohne Satelliten</tt:span>
        <tt:br />
        <tt:span style="textWhite">funktioniert unser Leben nicht mehr.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:29.240" end="00:05:30.800">
        <tt:span style="textWhite">Auch die Bundeswehr sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:30.920" end="00:05:33.360">
        <tt:span style="textWhite">Ohne Satelliten</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben wir ein Problem.</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:05:33.800" end="00:05:35.080">
        <tt:span style="textWhite">Dieser Soldat sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:05:35.560" end="00:05:39.400">
        <tt:span style="textWhite">Wir können das Land ohne Satelliten</tt:span>
        <tt:br />
        <tt:span style="textWhite">nur schlecht verteidigen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:05:39.480" end="00:05:42.040">
        <tt:span style="textWhite">weil wir dann</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr schwer Ziele finden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:05:42.600" end="00:05:43.800">
        <tt:span style="textWhite">Russland sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:05:44.040" end="00:05:47.280">
        <tt:span style="textWhite">Wir wollen keine Atombomben</tt:span>
        <tt:br />
        <tt:span style="textWhite">in den Weltraum bringen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:05:47.440" end="00:05:50.000">
        <tt:span style="textWhite">Mehrere Länder</tt:span>
        <tt:br />
        <tt:span style="textWhite">glauben das aber nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:05:51.960" end="00:05:54.160">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:05:58.480" end="00:06:03.000">
        <tt:span style="textWhite">Die Firma Nvidia kommt aus den USA</tt:span>
        <tt:br />
        <tt:span style="textWhite">und entwirft Computerteile.</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:06:05.240" end="00:06:09.520">
        <tt:span style="textWhite">Der Chef von Nvidia hat seinen Job</tt:span>
        <tt:br />
        <tt:span style="textWhite">vor wenigen Tagen abgegeben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:06:10.200" end="00:06:13.440">
        <tt:span style="textWhite">Er heißt Jensen Huang</tt:span>
        <tt:br />
        <tt:span style="textWhite">und ist auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:06:14.680" end="00:06:17.920">
        <tt:span style="textWhite">Huang hatte nämlich</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine Affäre mit einer Frau.</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:06:18.720" end="00:06:22.200">
        <tt:span style="textWhite">Sie soll als Spionin</tt:span>
        <tt:br />
        <tt:span style="textWhite">für China gearbeitet haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:06:23.480" end="00:06:25.560">
        <tt:span style="textWhite">Jetzt hat Nvidia mitgeteilt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:06:26.200" end="00:06:29.040">
        <tt:span style="textWhite">Huang kommt zurück</tt:span>
        <tt:br />
        <tt:span style="textWhite">als Chef von der Firma.</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:06:30.000" end="00:06:32.440">
        <tt:span style="textWhite">Die Regierung von den USA sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:06:33.360" end="00:06:36.080">
        <tt:span style="textWhite">Huang hat nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen Regeln verstoßen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:06:37.000" end="00:06:40.440">
        <tt:span style="textWhite">Der Präsident von den USA, Trump,</tt:span>
        <tt:br />
        <tt:span style="textWhite">freut sich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:06:41.600" end="00:06:44.600">
        <tt:span style="textWhite">In den letzten Tagen</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat er immer wieder gesagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:06:44.960" end="00:06:46.840">
        <tt:span style="textWhite">Huang soll zurückkommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:06:49.120" end="00:06:51.240">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht:</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:06:56.040" end="00:06:58.400">
        <tt:span style="textWhite">Am Sonntag ist der Erste Advent.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:06:59.160" end="00:07:01.640">
        <tt:span style="textWhite">In einem Monat ist Weihnachten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:07:02.560" end="00:07:06.640">
        <tt:span style="textWhite">In vielen Städten haben jetzt</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Weihnachtsmärkte geöffnet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:07:07.600" end="00:07:11.760">
        <tt:span style="textWhite">In Deutschland gibt es ungefähr</tt:span>
        <tt:br />
        <tt:span style="textWhite">3000 größere Weihnachtsmärkte.</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:07:13.000" end="00:07:15.960">
        <tt:span style="textWhite">Dazu zeigen wir jetzt</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen kurzen Film:</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:07:17.000" end="00:07:20.160">
        <tt:span style="textWhite">In der Stadt Düsseldorf,</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Westen von Deutschland,</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:07:20.280" end="00:07:23.960">
        <tt:span style="textWhite">ist der Weihnachtsmarkt</tt:span>
        <tt:br />
        <tt:span style="textWhite">schon seit dem Wochenende offen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:07:24.520" end="00:07:27.160">
        <tt:span style="textWhite">Dort gibt es schon</tt:span>
        <tt:br />
        <tt:span style="textWhite">Glühwein und Kekse.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:07:28.000" end="00:07:31.440">
        <tt:span style="textWhite">Auch viele andere Geschäfte</tt:span>
        <tt:br />
        <tt:span style="textWhite">in den Städten freuen sich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:07:32.000" end="00:07:35.480">
        <tt:span style="textWhite">Weil es Weihnachtsmärkte gibt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind viele Menschen da,</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:07:36.040" end="00:07:38.720">
        <tt:span style="textWhite">die auch in anderen Geschäften</tt:span>
        <tt:br />
        <tt:span style="textWhite">einkaufen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub117" style="textCenter" region="bottom" begin="00:07:40.840" end="00:07:43.000">
        <tt:span style="textWhite">Und das waren unsere Nachrichten:</tt:span>
      </tt:p>
      <tt:p xml:id="sub118" style="textCenter" region="bottom" begin="00:08:05.600" end="00:08:07.560">
        <tt:span style="textWhite">Und jetzt kommt das Wetter:</tt:span>
      </tt:p>
      <tt:p xml:id="sub119" style="textCenter" region="bottom" begin="00:08:08.880" end="00:08:13.240">
        <tt:span style="textWhite">Oben im Norden und rechts im Osten</tt:span>
        <tt:br />
        <tt:span style="textWhite">gibt es an manchen Orten Schnee.</tt:span>
      </tt:p>
      <tt:p xml:id="sub120" style="textCenter" region="bottom" begin="00:08:14.000" end="00:08:15.480">
        <tt:span style="textWhite">Sonst ist es trocken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub121" style="textCenter" region="bottom" begin="00:08:15.720" end="00:08:17.640">
        <tt:span style="textWhite">Meistens scheint die Sonne.</tt:span>
      </tt:p>
      <tt:p xml:id="sub122" style="textCenter" region="bottom" begin="00:08:17.760" end="00:08:19.920">
        <tt:span style="textWhite">Teilweise gibt es dichten Nebel.</tt:span>
      </tt:p>
      <tt:p xml:id="sub123" style="textCenter" region="bottom" begin="00:08:20.600" end="00:08:22.840">
        <tt:span style="textWhite">Es werden zwei bis sechs Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub124" style="textCenter" region="bottom" begin="00:08:25.000" end="00:08:27.800">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub125" style="textCenter" region="bottom" begin="00:08:29.040" end="00:08:31.040">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub126" style="textCenter" region="bottom" begin="00:08:35.760" end="00:08:38.240">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
