    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:00.000" end="00:00:01.000">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:01.600" end="00:00:04.320">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:07.480" end="00:00:10.360">
        <tt:span style="textWhite">Willkommen</tt:span>
        <tt:br />
        <tt:span style="textWhite">zur tagesschau in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:10.400" end="00:00:14.200">
        <tt:span style="textWhite">Ich bin Susanne Holst</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:30.880" end="00:00:34.120">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:39.160" end="00:00:41.800">
        <tt:span style="textWhite">Die Menschen in den USA</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben gewählt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:42.120" end="00:00:45.560">
        <tt:span style="textWhite">Sie haben nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">über Präsident Trump entschieden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:45.800" end="00:00:49.000">
        <tt:span style="textWhite">Sie haben Politiker</tt:span>
        <tt:br />
        <tt:span style="textWhite">für das Parlament gewählt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:49.280" end="00:00:52.560">
        <tt:span style="textWhite">Das Parlament besteht</tt:span>
        <tt:br />
        <tt:span style="textWhite">aus zwei Teilen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:52.760" end="00:00:56.280">
        <tt:span style="textWhite">Dem Repräsentantenhaus und dem Senat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:00:56.840" end="00:01:00.880">
        <tt:span style="textWhite">Beide arbeiten in diesem Haus hier</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:01.760" end="00:01:05.160">
        <tt:span style="textWhite">Bisher hat die Partei</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Republikanern</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:05.200" end="00:01:07.840">
        <tt:span style="textWhite">die Mehrheit in beiden Teilen gehabt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:08.560" end="00:01:11.360">
        <tt:span style="textWhite">Auch Präsident Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist bei den Republikanern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:11.400" end="00:01:15.400">
        <tt:span style="textWhite">Die Wahl hat aber die Partei</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Demokraten gewonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:15.720" end="00:01:19.920">
        <tt:span style="textWhite">Sie haben jetzt die Mehrheit</tt:span>
        <tt:br />
        <tt:span style="textWhite">in beiden Teilen vom Parlament.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:20.960" end="00:01:25.240">
        <tt:span style="textWhite">Für die Republikaner und für Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist das eine Niederlage.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:25.760" end="00:01:29.080">
        <tt:span style="textWhite">Die Demokraten freuen sich dagegen</tt:span>
        <tt:br />
        <tt:span style="textWhite">über den Sieg.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:29.120" end="00:01:31.040">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:32.120" end="00:01:33.960">
        <tt:span style="textWhite">Die Menschen jubeln.</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:34.120" end="00:01:36.880">
        <tt:span style="textWhite">Sie feiern den Sieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Demokraten</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:36.920" end="00:01:38.160">
        <tt:span style="textWhite">bei der Wahl.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:38.760" end="00:01:43.080">
        <tt:span style="textWhite">Dieser Mann sagt, ich bin so froh,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wir haben es geschafft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:43.880" end="00:01:47.680">
        <tt:span style="textWhite">Und dieser Mann sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">das haben wir gebraucht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:01:48.800" end="00:01:53.280">
        <tt:span style="textWhite">Im Bundesstaat Texas waren</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Jahre die Republikaner vorn.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:01:53.320" end="00:01:57.720">
        <tt:span style="textWhite">Jetzt hat James Talarico</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Demokraten gewonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:01:58.080" end="00:02:01.480">
        <tt:span style="textWhite">Er ist künftig für Texas im US-Senat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:01.720" end="00:02:06.480">
        <tt:span style="textWhite">Und er sagt, der Wahlkampf</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen die Republikaner war schwer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:06.680" end="00:02:09.480">
        <tt:span style="textWhite">Sie haben sehr viel Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">dafür bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:09.640" end="00:02:12.560">
        <tt:span style="textWhite">Und trotzdem, wir haben es geschafft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:13.600" end="00:02:17.840">
        <tt:span style="textWhite">Auch in anderen US-Bundesstaaten</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben die Demokraten</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:17.880" end="00:02:19.760">
        <tt:span style="textWhite">Sitze im Senat gewonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:20.160" end="00:02:24.600">
        <tt:span style="textWhite">Und sie haben jetzt mehr Gouverneure</tt:span>
        <tt:br />
        <tt:span style="textWhite">als die Republikaner.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:25.120" end="00:02:29.400">
        <tt:span style="textWhite">Gouverneure sind die Regierungschefs</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Bundesstaaten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:29.440" end="00:02:33.480">
        <tt:span style="textWhite">Der Politik-Experte David Parker</tt:span>
        <tt:br />
        <tt:span style="textWhite">sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:33.800" end="00:02:38.960">
        <tt:span style="textWhite">die Wahl ist eine Abstimmung</tt:span>
        <tt:br />
        <tt:span style="textWhite">über Trump und die Republikaner.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:39.160" end="00:02:40.840">
        <tt:span style="textWhite">Das Ergebnis zeigt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:41.360" end="00:02:44.520">
        <tt:span style="textWhite">für die Republikaner geht es</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach unten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:45.480" end="00:02:47.880">
        <tt:span style="textWhite">Präsident Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat nach der Niederlage</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:47.920" end="00:02:50.920">
        <tt:span style="textWhite">mit dem Fernsehsender Fox News</tt:span>
        <tt:br />
        <tt:span style="textWhite">telefoniert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:50.960" end="00:02:56.160">
        <tt:span style="textWhite">Und er hat gesagt, wenn mein Name</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Wahlzettel steht,</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:02:56.680" end="00:02:58.600">
        <tt:span style="textWhite">dann passiert was so nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:02:58.920" end="00:03:02.880">
        <tt:span style="textWhite">Trump will das Ergebnis</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Wahl akzeptieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:03.000" end="00:03:07.240">
        <tt:span style="textWhite">Und er will den Demokraten</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Arbeit schwer machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:09.280" end="00:03:10.960">
        <tt:span style="textWhite">Wir bleiben beim Thema.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:15.280" end="00:03:18.800">
        <tt:span style="textWhite">Die USA sind sehr wichtig</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die deutsche Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:18.840" end="00:03:23.800">
        <tt:span style="textWhite">Deutsche Firmen verkaufen nämlich</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Produkte in die USA,</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:23.840" end="00:03:25.280">
        <tt:span style="textWhite">z.B. Autos.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:25.800" end="00:03:29.760">
        <tt:span style="textWhite">Nach der Wahl in den USA haben</tt:span>
        <tt:br />
        <tt:span style="textWhite">die deutschen Firmen deshalb</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:29.800" end="00:03:30.800">
        <tt:span style="textWhite">eine Frage.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:31.360" end="00:03:34.920">
        <tt:span style="textWhite">Wie reagiert US-Präsident Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf die Niederlage?</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:35.600" end="00:03:39.200">
        <tt:span style="textWhite">Was wird er jetzt mit den Zöllen</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Wirtschaft machen?</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:39.240" end="00:03:41.240">
        <tt:span style="textWhite">Zölle sind extra Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:41.560" end="00:03:43.480">
        <tt:span style="textWhite">Sie machen Produkte teurer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:43.840" end="00:03:45.440">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:45.480" end="00:03:49.000">
        <tt:span style="textWhite">US-Präsident Trump sagt Zölle.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:03:49.560" end="00:03:52.000">
        <tt:span style="textWhite">Das Wort habe ich besonders gern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:03:52.520" end="00:03:55.760">
        <tt:span style="textWhite">Mit den Zöllen will Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Wirtschaft in den USA</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:03:55.800" end="00:03:56.800">
        <tt:span style="textWhite">besser machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:03:57.200" end="00:04:01.120">
        <tt:span style="textWhite">Für deutsche Firmen bedeuten</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Zölle aber mehr Kosten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:01.560" end="00:04:05.760">
        <tt:span style="textWhite">Die Firmen fragen deshalb,</tt:span>
        <tt:br />
        <tt:span style="textWhite">macht Trump jetzt neue Zölle?</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:05.800" end="00:04:11.960">
        <tt:span style="textWhite">Das kann man schwer einschätzen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">meint der Experte Metin Haqverdi.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:12.120" end="00:04:15.360">
        <tt:span style="textWhite">Er sagt, Trump ändert oft</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Meinung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:15.560" end="00:04:19.520">
        <tt:span style="textWhite">Das bleibt wahrscheinlich so,</tt:span>
        <tt:br />
        <tt:span style="textWhite">auch nach der Niederlage.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:20.000" end="00:04:22.640">
        <tt:span style="textWhite">Das Thema Zölle</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommt bestimmt zurück.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:23.200" end="00:04:25.560">
        <tt:span style="textWhite">Darauf müssen wir uns einstellen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:26.520" end="00:04:30.520">
        <tt:span style="textWhite">Neue Zölle, das ist ein Problem</tt:span>
        <tt:br />
        <tt:span style="textWhite">für deutsche Firmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:30.560" end="00:04:36.400">
        <tt:span style="textWhite">Ob Autos oder Medikamente, es</tt:span>
        <tt:br />
        <tt:span style="textWhite">gibt dann noch weniger Handel.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:37.160" end="00:04:41.520">
        <tt:span style="textWhite">Aber Trump findet die Zölle gut</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Wirtschaft in den USA.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:41.760" end="00:04:45.840">
        <tt:span style="textWhite">Schon vor Monaten hat er gesagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wer keine Zölle will,</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:46.040" end="00:04:50.120">
        <tt:span style="textWhite">der muss Werke in den USA</tt:span>
        <tt:br />
        <tt:span style="textWhite">bauen und hier produzieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:04:50.160" end="00:04:54.840">
        <tt:span style="textWhite">Der Chef von der deutschen Firma Audi</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat das versprochen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:04:55.080" end="00:04:57.640">
        <tt:span style="textWhite">Ein Autowerk in den USA.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:04:58.320" end="00:05:02.240">
        <tt:span style="textWhite">Viele Menschen in Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">finden das gar nicht gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:03.280" end="00:05:05.760">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:10.400" end="00:05:11.800">
        <tt:span style="textWhite">In vielen Bundesländern</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:11.840" end="00:05:15.120">
        <tt:span style="textWhite">hat eine große Übung</tt:span>
        <tt:br />
        <tt:span style="textWhite">für eine Krise begonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:15.640" end="00:05:17.560">
        <tt:span style="textWhite">Die Krise ist nicht echt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:17.600" end="00:05:21.120">
        <tt:span style="textWhite">Aber die Bundesländer</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen gut vorbereitet sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:21.360" end="00:05:22.560">
        <tt:span style="textWhite">Deshalb üben sie.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:23.120" end="00:05:26.520">
        <tt:span style="textWhite">Sie sagen, wir stellen uns</tt:span>
        <tt:br />
        <tt:span style="textWhite">diese Situation vor.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:26.840" end="00:05:30.000">
        <tt:span style="textWhite">Es ist schon mehrere Jahre</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr trocken in Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:30.040" end="00:05:32.120">
        <tt:span style="textWhite">Und es gibt eine große Hitze.</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:32.360" end="00:05:33.760">
        <tt:span style="textWhite">Das Wasser ist knapp.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:33.800" end="00:05:35.720">
        <tt:span style="textWhite">Die Krankenhäuser sind voll.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:35.760" end="00:05:37.120">
        <tt:span style="textWhite">Was müssen wir tun?</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:05:37.600" end="00:05:41.440">
        <tt:span style="textWhite">Wer muss mit wem sprechen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">schreiben oder telefonieren?</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:05:41.600" end="00:05:43.120">
        <tt:span style="textWhite">Wer muss entscheiden?</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:05:43.560" end="00:05:46.400">
        <tt:span style="textWhite">Die Bundesländer</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen bei der Übung lernen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:05:46.440" end="00:05:49.520">
        <tt:span style="textWhite">wie können wir</tt:span>
        <tt:br />
        <tt:span style="textWhite">noch besser zusammenarbeiten?</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:05:50.560" end="00:05:53.120">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:05:57.560" end="00:06:00.600">
        <tt:span style="textWhite">Hier auf dem Foto ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">der Autor Janosch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:06:00.800" end="00:06:03.520">
        <tt:span style="textWhite">Er hat viele Bücher</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Kinder geschrieben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:06:03.560" end="00:06:06.400">
        <tt:span style="textWhite">Und er hat die Bücher auch gestaltet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:06:06.960" end="00:06:10.200">
        <tt:span style="textWhite">Das bedeutet, er</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat die Bilder dafür gemalt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:06:10.240" end="00:06:13.160">
        <tt:span style="textWhite">Janosch ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">in vielen Ländern bekannt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:06:13.840" end="00:06:15.480">
        <tt:span style="textWhite">Jetzt ist er gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:06:15.680" end="00:06:17.720">
        <tt:span style="textWhite">Er wurde 95 Jahre alt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:06:18.600" end="00:06:21.040">
        <tt:span style="textWhite">Über Janosch kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:06:21.160" end="00:06:22.800">
        <tt:span style="textWhite">Das ist Janosch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:06:23.280" end="00:06:25.800">
        <tt:span style="textWhite">Eigentlich heißt er Horst Eckert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:06:26.480" end="00:06:28.840">
        <tt:span style="textWhite">Janosch ist der Name als Künstler.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:06:28.880" end="00:06:33.560">
        <tt:span style="textWhite">Viele Menschen auf der Welt</tt:span>
        <tt:br />
        <tt:span style="textWhite">kennen die Bücher von Janosch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:06:34.040" end="00:06:37.600">
        <tt:span style="textWhite">Besonders bekannt ist die Tigerente.</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:06:38.440" end="00:06:41.440">
        <tt:span style="textWhite">Also eine Ente mit Streifen</tt:span>
        <tt:br />
        <tt:span style="textWhite">wie bei einem Tiger.</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:06:41.560" end="00:06:44.480">
        <tt:span style="textWhite">Und die Freunde Bär und Tiger.</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:06:45.480" end="00:06:49.440">
        <tt:span style="textWhite">Janosch sagt, ich</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollte ein einfaches Buch machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:06:49.560" end="00:06:51.080">
        <tt:span style="textWhite">Dafür gibt es Regeln.</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:06:51.440" end="00:06:52.520">
        <tt:span style="textWhite">Ein netter Bär.</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:06:52.600" end="00:06:54.280">
        <tt:span style="textWhite">Der Bär macht eine Reise.</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:06:54.320" end="00:06:56.800">
        <tt:span style="textWhite">Und er muss einen Freund haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:06:57.920" end="00:07:00.760">
        <tt:span style="textWhite">Janosch wurde in dem Land Polen</tt:span>
        <tt:br />
        <tt:span style="textWhite">geboren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:07:01.160" end="00:07:03.240">
        <tt:span style="textWhite">Die Eltern waren sehr streng.</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:07:03.440" end="00:07:05.560">
        <tt:span style="textWhite">Der Vater trank oft Alkohol.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:07:06.280" end="00:07:09.600">
        <tt:span style="textWhite">Für Janosch war Freiheit</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr wichtig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:07:10.360" end="00:07:12.240">
        <tt:span style="textWhite">Er liebte die Einsamkeit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:07:12.680" end="00:07:16.880">
        <tt:span style="textWhite">Auf der spanischen Insel Teneriffa</tt:span>
        <tt:br />
        <tt:span style="textWhite">lebte er deshalb gern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub117" style="textCenter" region="bottom" begin="00:07:17.480" end="00:07:19.000">
        <tt:span style="textWhite">Bis zum Tod.</tt:span>
      </tt:p>
      <tt:p xml:id="sub118" style="textCenter" region="bottom" begin="00:07:21.400" end="00:07:23.560">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub119" style="textCenter" region="bottom" begin="00:07:40.040" end="00:07:41.960">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub120" style="textCenter" region="bottom" begin="00:07:42.640" end="00:07:44.320">
        <tt:span style="textWhite">Zuerst ist es wolkig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub121" style="textCenter" region="bottom" begin="00:07:44.440" end="00:07:47.080">
        <tt:span style="textWhite">Später scheint in vielen Gebieten</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Sonne.</tt:span>
      </tt:p>
      <tt:p xml:id="sub122" style="textCenter" region="bottom" begin="00:07:47.120" end="00:07:49.440">
        <tt:span style="textWhite">Es werden 4 bis 13 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub123" style="textCenter" region="bottom" begin="00:07:51.000" end="00:07:53.680">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub124" style="textCenter" region="bottom" begin="00:07:53.720" end="00:07:55.880">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub125" style="textCenter" region="bottom" begin="00:08:00.840" end="00:08:03.000">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
