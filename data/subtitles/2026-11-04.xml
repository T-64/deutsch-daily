  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:03.000" end="00:00:04.000">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:04.600" end="00:00:07.320">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:10.480" end="00:00:13.360">
        <tt:span style="textWhite">Willkommen</tt:span>
        <tt:br />
        <tt:span style="textWhite">zur tagesschau in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:13.420" end="00:00:17.220">
        <tt:span style="textWhite">Ich bin Susanne Holst</tt:span>
        <tt:br />
        <tt:span style="textWhite">und das sind unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:33.900" end="00:00:37.140">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:42.180" end="00:00:44.820">
        <tt:span style="textWhite">Die Menschen in den USA</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben gewählt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:45.140" end="00:00:48.580">
        <tt:span style="textWhite">Sie haben nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">über Präsident Trump entschieden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:48.820" end="00:00:52.020">
        <tt:span style="textWhite">Sie haben Politiker</tt:span>
        <tt:br />
        <tt:span style="textWhite">für das Parlament gewählt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:52.300" end="00:00:55.580">
        <tt:span style="textWhite">Das Parlament besteht</tt:span>
        <tt:br />
        <tt:span style="textWhite">aus zwei Teilen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:55.780" end="00:00:59.300">
        <tt:span style="textWhite">Dem Repräsentantenhaus und dem Senat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:00:59.860" end="00:01:03.900">
        <tt:span style="textWhite">Beide arbeiten in diesem Haus hier</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:04.780" end="00:01:08.180">
        <tt:span style="textWhite">Bisher hat die Partei</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Republikanern</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:08.220" end="00:01:10.860">
        <tt:span style="textWhite">die Mehrheit in beiden Teilen gehabt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:11.580" end="00:01:14.380">
        <tt:span style="textWhite">Auch Präsident Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist bei den Republikanern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:14.420" end="00:01:18.420">
        <tt:span style="textWhite">Die Wahl hat aber die Partei</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Demokraten gewonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:18.740" end="00:01:22.940">
        <tt:span style="textWhite">Sie haben jetzt die Mehrheit</tt:span>
        <tt:br />
        <tt:span style="textWhite">in beiden Teilen vom Parlament.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:23.980" end="00:01:28.260">
        <tt:span style="textWhite">Für die Republikaner und für Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist das eine Niederlage.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:28.780" end="00:01:32.100">
        <tt:span style="textWhite">Die Demokraten freuen sich dagegen</tt:span>
        <tt:br />
        <tt:span style="textWhite">über den Sieg.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:32.140" end="00:01:34.060">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:35.140" end="00:01:36.980">
        <tt:span style="textWhite">Die Menschen jubeln.</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:37.140" end="00:01:39.900">
        <tt:span style="textWhite">Sie feiern den Sieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Demokraten</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:39.940" end="00:01:41.180">
        <tt:span style="textWhite">bei der Wahl.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:41.780" end="00:01:46.100">
        <tt:span style="textWhite">Dieser Mann sagt, ich bin so froh,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wir haben es geschafft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:46.900" end="00:01:50.700">
        <tt:span style="textWhite">Und dieser Mann sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">das haben wir gebraucht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:01:51.820" end="00:01:56.300">
        <tt:span style="textWhite">Im Bundesstaat Texas waren</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Jahre die Republikaner vorn.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:01:56.340" end="00:02:00.740">
        <tt:span style="textWhite">Jetzt hat James Talarico</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Demokraten gewonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:01.100" end="00:02:04.500">
        <tt:span style="textWhite">Er ist künftig für Texas im US-Senat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:04.740" end="00:02:09.500">
        <tt:span style="textWhite">Und er sagt, der Wahlkampf</tt:span>
        <tt:br />
        <tt:span style="textWhite">gegen die Republikaner war schwer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:09.700" end="00:02:12.500">
        <tt:span style="textWhite">Sie haben sehr viel Geld</tt:span>
        <tt:br />
        <tt:span style="textWhite">dafür bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:12.660" end="00:02:15.580">
        <tt:span style="textWhite">Und trotzdem, wir haben es geschafft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:16.620" end="00:02:20.860">
        <tt:span style="textWhite">Auch in anderen US-Bundesstaaten</tt:span>
        <tt:br />
        <tt:span style="textWhite">haben die Demokraten</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:20.900" end="00:02:22.780">
        <tt:span style="textWhite">Sitze im Senat gewonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:23.180" end="00:02:27.620">
        <tt:span style="textWhite">Und sie haben jetzt mehr Gouverneure</tt:span>
        <tt:br />
        <tt:span style="textWhite">als die Republikaner.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:28.140" end="00:02:32.420">
        <tt:span style="textWhite">Gouverneure sind die Regierungschefs</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Bundesstaaten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:32.460" end="00:02:36.500">
        <tt:span style="textWhite">Der Politik-Experte David Parker</tt:span>
        <tt:br />
        <tt:span style="textWhite">sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:36.820" end="00:02:41.980">
        <tt:span style="textWhite">die Wahl ist eine Abstimmung</tt:span>
        <tt:br />
        <tt:span style="textWhite">über Trump und die Republikaner.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:42.180" end="00:02:43.860">
        <tt:span style="textWhite">Das Ergebnis zeigt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:44.380" end="00:02:47.540">
        <tt:span style="textWhite">für die Republikaner geht es</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach unten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:48.500" end="00:02:50.900">
        <tt:span style="textWhite">Präsident Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat nach der Niederlage</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:50.940" end="00:02:53.940">
        <tt:span style="textWhite">mit dem Fernsehsender Fox News</tt:span>
        <tt:br />
        <tt:span style="textWhite">telefoniert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:53.980" end="00:02:59.180">
        <tt:span style="textWhite">Und er hat gesagt, wenn mein Name</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Wahlzettel steht,</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:02:59.700" end="00:03:01.620">
        <tt:span style="textWhite">dann passiert was so nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:01.940" end="00:03:05.900">
        <tt:span style="textWhite">Trump will das Ergebnis</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Wahl akzeptieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:06.020" end="00:03:10.260">
        <tt:span style="textWhite">Und er will den Demokraten</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Arbeit schwer machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:12.280" end="00:03:13.960">
        <tt:span style="textWhite">Wir bleiben beim Thema.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:18.300" end="00:03:21.820">
        <tt:span style="textWhite">Die USA sind sehr wichtig</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die deutsche Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:21.860" end="00:03:26.820">
        <tt:span style="textWhite">Deutsche Firmen verkaufen nämlich</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Produkte in die USA,</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:26.860" end="00:03:28.300">
        <tt:span style="textWhite">z.B. Autos.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:28.820" end="00:03:32.780">
        <tt:span style="textWhite">Nach der Wahl in den USA haben</tt:span>
        <tt:br />
        <tt:span style="textWhite">die deutschen Firmen deshalb</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:32.820" end="00:03:33.820">
        <tt:span style="textWhite">eine Frage.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:34.380" end="00:03:37.940">
        <tt:span style="textWhite">Wie reagiert US-Präsident Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf die Niederlage?</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:38.620" end="00:03:42.220">
        <tt:span style="textWhite">Was wird er jetzt mit den Zöllen</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Wirtschaft machen?</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:42.260" end="00:03:44.260">
        <tt:span style="textWhite">Zölle sind extra Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:44.580" end="00:03:46.500">
        <tt:span style="textWhite">Sie machen Produkte teurer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:46.840" end="00:03:48.440">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:48.500" end="00:03:52.020">
        <tt:span style="textWhite">US-Präsident Trump sagt Zölle.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:03:52.580" end="00:03:55.020">
        <tt:span style="textWhite">Das Wort habe ich besonders gern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:03:55.540" end="00:03:58.780">
        <tt:span style="textWhite">Mit den Zöllen will Trump</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Wirtschaft in den USA</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:03:58.820" end="00:03:59.820">
        <tt:span style="textWhite">besser machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:00.220" end="00:04:04.140">
        <tt:span style="textWhite">Für deutsche Firmen bedeuten</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Zölle aber mehr Kosten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:04.580" end="00:04:08.780">
        <tt:span style="textWhite">Die Firmen fragen deshalb,</tt:span>
        <tt:br />
        <tt:span style="textWhite">macht Trump jetzt neue Zölle?</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:08.820" end="00:04:14.980">
        <tt:span style="textWhite">Das kann man schwer einschätzen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">meint der Experte Metin Haqverdi.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:15.140" end="00:04:18.380">
        <tt:span style="textWhite">Er sagt, Trump ändert oft</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Meinung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:18.580" end="00:04:22.540">
        <tt:span style="textWhite">Das bleibt wahrscheinlich so,</tt:span>
        <tt:br />
        <tt:span style="textWhite">auch nach der Niederlage.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:23.020" end="00:04:25.660">
        <tt:span style="textWhite">Das Thema Zölle</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommt bestimmt zurück.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:26.220" end="00:04:28.580">
        <tt:span style="textWhite">Darauf müssen wir uns einstellen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:29.540" end="00:04:33.540">
        <tt:span style="textWhite">Neue Zölle, das ist ein Problem</tt:span>
        <tt:br />
        <tt:span style="textWhite">für deutsche Firmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:33.580" end="00:04:39.420">
        <tt:span style="textWhite">Ob Autos oder Medikamente, es</tt:span>
        <tt:br />
        <tt:span style="textWhite">gibt dann noch weniger Handel.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:40.180" end="00:04:44.540">
        <tt:span style="textWhite">Aber Trump findet die Zölle gut</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Wirtschaft in den USA.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:44.780" end="00:04:48.860">
        <tt:span style="textWhite">Schon vor Monaten hat er gesagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wer keine Zölle will,</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:49.060" end="00:04:53.140">
        <tt:span style="textWhite">der muss Werke in den USA</tt:span>
        <tt:br />
        <tt:span style="textWhite">bauen und hier produzieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:04:53.180" end="00:04:57.860">
        <tt:span style="textWhite">Der Chef von der deutschen Firma Audi</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat das versprochen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:04:58.100" end="00:05:00.660">
        <tt:span style="textWhite">Ein Autowerk in den USA.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:01.340" end="00:05:05.260">
        <tt:span style="textWhite">Viele Menschen in Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">finden das gar nicht gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:06.300" end="00:05:08.780">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:13.420" end="00:05:14.820">
        <tt:span style="textWhite">In vielen Bundesländern</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:14.860" end="00:05:18.140">
        <tt:span style="textWhite">hat eine große Übung</tt:span>
        <tt:br />
        <tt:span style="textWhite">für eine Krise begonnen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:18.660" end="00:05:20.580">
        <tt:span style="textWhite">Die Krise ist nicht echt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:20.620" end="00:05:24.140">
        <tt:span style="textWhite">Aber die Bundesländer</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen gut vorbereitet sein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:24.380" end="00:05:25.580">
        <tt:span style="textWhite">Deshalb üben sie.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:26.140" end="00:05:29.540">
        <tt:span style="textWhite">Sie sagen, wir stellen uns</tt:span>
        <tt:br />
        <tt:span style="textWhite">diese Situation vor.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:29.860" end="00:05:33.020">
        <tt:span style="textWhite">Es ist schon mehrere Jahre</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr trocken in Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:33.060" end="00:05:35.140">
        <tt:span style="textWhite">Und es gibt eine große Hitze.</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:35.380" end="00:05:36.780">
        <tt:span style="textWhite">Das Wasser ist knapp.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:36.820" end="00:05:38.740">
        <tt:span style="textWhite">Die Krankenhäuser sind voll.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:38.780" end="00:05:40.140">
        <tt:span style="textWhite">Was müssen wir tun?</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:05:40.620" end="00:05:44.460">
        <tt:span style="textWhite">Wer muss mit wem sprechen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">schreiben oder telefonieren?</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:05:44.620" end="00:05:46.140">
        <tt:span style="textWhite">Wer muss entscheiden?</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:05:46.580" end="00:05:49.420">
        <tt:span style="textWhite">Die Bundesländer</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollen bei der Übung lernen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:05:49.460" end="00:05:52.540">
        <tt:span style="textWhite">wie können wir</tt:span>
        <tt:br />
        <tt:span style="textWhite">noch besser zusammenarbeiten?</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:05:53.580" end="00:05:56.140">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:06:00.580" end="00:06:03.620">
        <tt:span style="textWhite">Hier auf dem Foto ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">der Autor Janosch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:06:03.820" end="00:06:06.540">
        <tt:span style="textWhite">Er hat viele Bücher</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Kinder geschrieben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:06:06.580" end="00:06:09.420">
        <tt:span style="textWhite">Und er hat die Bücher auch gestaltet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:06:09.980" end="00:06:13.220">
        <tt:span style="textWhite">Das bedeutet, er</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat die Bilder dafür gemalt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:06:13.260" end="00:06:16.180">
        <tt:span style="textWhite">Janosch ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">in vielen Ländern bekannt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:06:16.860" end="00:06:18.500">
        <tt:span style="textWhite">Jetzt ist er gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:06:18.700" end="00:06:20.740">
        <tt:span style="textWhite">Er wurde 95 Jahre alt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:06:21.620" end="00:06:24.060">
        <tt:span style="textWhite">Über Janosch kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:06:24.180" end="00:06:25.820">
        <tt:span style="textWhite">Das ist Janosch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:06:26.300" end="00:06:28.820">
        <tt:span style="textWhite">Eigentlich heißt er Horst Eckert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:06:29.500" end="00:06:31.860">
        <tt:span style="textWhite">Janosch ist der Name als Künstler.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:06:31.900" end="00:06:36.580">
        <tt:span style="textWhite">Viele Menschen auf der Welt</tt:span>
        <tt:br />
        <tt:span style="textWhite">kennen die Bücher von Janosch.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:06:37.060" end="00:06:40.620">
        <tt:span style="textWhite">Besonders bekannt ist die Tigerente.</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:06:41.460" end="00:06:44.460">
        <tt:span style="textWhite">Also eine Ente mit Streifen</tt:span>
        <tt:br />
        <tt:span style="textWhite">wie bei einem Tiger.</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:06:44.580" end="00:06:47.500">
        <tt:span style="textWhite">Und die Freunde Bär und Tiger.</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:06:48.500" end="00:06:52.460">
        <tt:span style="textWhite">Janosch sagt, ich</tt:span>
        <tt:br />
        <tt:span style="textWhite">wollte ein einfaches Buch machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:06:52.580" end="00:06:54.100">
        <tt:span style="textWhite">Dafür gibt es Regeln.</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:06:54.460" end="00:06:55.540">
        <tt:span style="textWhite">Ein netter Bär.</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:06:55.620" end="00:06:57.300">
        <tt:span style="textWhite">Der Bär macht eine Reise.</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:06:57.340" end="00:06:59.820">
        <tt:span style="textWhite">Und er muss einen Freund haben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:07:00.940" end="00:07:03.780">
        <tt:span style="textWhite">Janosch wurde in dem Land Polen</tt:span>
        <tt:br />
        <tt:span style="textWhite">geboren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:07:04.180" end="00:07:06.260">
        <tt:span style="textWhite">Die Eltern waren sehr streng.</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:07:06.460" end="00:07:08.580">
        <tt:span style="textWhite">Der Vater trank oft Alkohol.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:07:09.300" end="00:07:12.620">
        <tt:span style="textWhite">Für Janosch war Freiheit</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr wichtig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:07:13.380" end="00:07:15.260">
        <tt:span style="textWhite">Er liebte die Einsamkeit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:07:15.700" end="00:07:19.900">
        <tt:span style="textWhite">Auf der spanischen Insel Teneriffa</tt:span>
        <tt:br />
        <tt:span style="textWhite">lebte er deshalb gern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub117" style="textCenter" region="bottom" begin="00:07:20.500" end="00:07:22.020">
        <tt:span style="textWhite">Bis zum Tod.</tt:span>
      </tt:p>
      <tt:p xml:id="sub118" style="textCenter" region="bottom" begin="00:07:24.420" end="00:07:26.580">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub119" style="textCenter" region="bottom" begin="00:07:43.060" end="00:07:44.980">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub120" style="textCenter" region="bottom" begin="00:07:45.660" end="00:07:47.340">
        <tt:span style="textWhite">Zuerst ist es wolkig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub121" style="textCenter" region="bottom" begin="00:07:47.440" end="00:07:50.080">
        <tt:span style="textWhite">Später scheint in vielen Gebieten</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Sonne.</tt:span>
      </tt:p>
      <tt:p xml:id="sub122" style="textCenter" region="bottom" begin="00:07:50.140" end="00:07:52.460">
        <tt:span style="textWhite">Es werden 4 bis 13 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub123" style="textCenter" region="bottom" begin="00:07:54.020" end="00:07:56.700">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub124" style="textCenter" region="bottom" begin="00:07:56.740" end="00:07:58.900">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub125" style="textCenter" region="bottom" begin="00:08:03.840" end="00:08:06.000">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
