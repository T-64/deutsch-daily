  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:00.000" end="00:00:01.000" />
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:02.960" end="00:00:03.960">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:04.320" end="00:00:07.040">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2025</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:10.480" end="00:00:13.760">
        <tt:span style="textWhite">Willkommen zur tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:13.920" end="00:00:18.000">
        <tt:span style="textWhite">Ich bin Michael Paweletz.</tt:span>
        <tt:br />
        <tt:span style="textWhite">Und das sind unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:31.640" end="00:00:33.720">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:35.070" end="00:00:41.790">
        <tt:span style="textWhite">Rhein, Wasser ist niedrig.</tt:span>
        <tt:br />
        <tt:span style="textWhite">Auf dem Foto ist der Rhein.</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:42.270" end="00:00:45.470">
        <tt:span style="textWhite">Der Rhein ist ein großer Fluss</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:45.870" end="00:00:49.470">
        <tt:span style="textWhite">Auf dem Rhein fahren jeden Tag</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Schiffe.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:49.990" end="00:00:53.710">
        <tt:span style="textWhite">Die Schiffe transportieren</tt:span>
        <tt:br />
        <tt:span style="textWhite">Sachen für Unternehmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:00:54.990" end="00:00:58.830">
        <tt:span style="textWhite">Momentan können viele Schiffe</tt:span>
        <tt:br />
        <tt:span style="textWhite">aber nicht fahren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:00:59.390" end="00:01:03.070">
        <tt:span style="textWhite">Das Wasser im Rhein</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist nämlich niedrig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:03.110" end="00:01:10.270">
        <tt:span style="textWhite">Es ist viel niedriger als sonst.</tt:span>
        <tt:br />
        <tt:span style="textWhite">Das ist ein Problem für die Schiffe.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:10.870" end="00:01:12.830">
        <tt:span style="textWhite">Dazu kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:14.230" end="00:01:18.990">
        <tt:span style="textWhite">Das ist der Rhein in Duisburg,</tt:span>
        <tt:br />
        <tt:span style="textWhite">links im Westen von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:19.430" end="00:01:22.510">
        <tt:span style="textWhite">Das Wasser ist niedriger</tt:span>
        <tt:br />
        <tt:span style="textWhite">als normalerweise.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:22.910" end="00:01:24.870">
        <tt:span style="textWhite">Wenn das Wasser niedrig ist,</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:24.910" end="00:01:28.390">
        <tt:span style="textWhite">dann können die Schiffe nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">so viele Sachen laden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:28.440" end="00:01:32.840">
        <tt:span style="textWhite">Sonst sind sie zu schwer</tt:span>
        <tt:br />
        <tt:span style="textWhite">und fahren sich auf dem Boden fest.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:33.910" end="00:01:38.270">
        <tt:span style="textWhite">Auch ein Stück weiter, in Köln,</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist das Wasser im Rhein niedrig.</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:38.470" end="00:01:41.990">
        <tt:span style="textWhite">Dieses Schiff kann</tt:span>
        <tt:br />
        <tt:span style="textWhite">nur wenig Ladung aufnehmen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:43.910" end="00:01:47.750">
        <tt:span style="textWhite">Das ist Markus Neumann</tt:span>
        <tt:br />
        <tt:span style="textWhite">von einer Kölner Behörde.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:48.630" end="00:01:52.150">
        <tt:span style="textWhite">Er sagt, es lohnt sich für das Schiff</tt:span>
        <tt:br />
        <tt:span style="textWhite">gar nicht zu fahren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:52.190" end="00:01:56.270">
        <tt:span style="textWhite">Der Sprit ist wahrscheinlich</tt:span>
        <tt:br />
        <tt:span style="textWhite">zu teuer bei so wenig Ladung.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:01:57.030" end="00:02:00.270">
        <tt:span style="textWhite">Die Politik sucht</tt:span>
        <tt:br />
        <tt:span style="textWhite">eine Lösung für die Schiffe.</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:02:00.710" end="00:02:04.430">
        <tt:span style="textWhite">Der Minister für Verkehr,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Steffen Bilger, schlägt vor,</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:02:04.910" end="00:02:06.950">
        <tt:span style="textWhite">Lkw könnten ausnahmsweise</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:06.990" end="00:02:09.790">
        <tt:span style="textWhite">auch an Sonntagen und Feiertagen</tt:span>
        <tt:br />
        <tt:span style="textWhite">fahren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:10.270" end="00:02:13.430">
        <tt:span style="textWhite">Und man könnte den Rhein</tt:span>
        <tt:br />
        <tt:span style="textWhite">tiefer machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:15.040" end="00:02:16.320">
        <tt:span style="textWhite">Bilger sagt:</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:16.440" end="00:02:18.280">
        <tt:span style="textWhite">Wenn der Fluss tiefer ist,</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:18.440" end="00:02:21.600">
        <tt:span style="textWhite">können wir wieder mehr</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf die Schiffe laden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:21.720" end="00:02:24.240">
        <tt:span style="textWhite">Das ist wichtig für die Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:24.440" end="00:02:27.080">
        <tt:span style="textWhite">Aber nicht jeder findet die Idee gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:28.350" end="00:02:31.590">
        <tt:span style="textWhite">Markus Neumann sagt: Wenn wir</tt:span>
        <tt:br />
        <tt:span style="textWhite">den Fluss tiefer machen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:31.630" end="00:02:34.790">
        <tt:span style="textWhite">dann bekommen wir trotzdem nicht</tt:span>
        <tt:br />
        <tt:span style="textWhite">mehr Wasser.</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:35.190" end="00:02:39.350">
        <tt:span style="textWhite">Fachleute sagen, das Wasser im Rhein</tt:span>
        <tt:br />
        <tt:span style="textWhite">könnte noch ein paar Wochen</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:39.390" end="00:02:40.670">
        <tt:span style="textWhite">niedrig bleiben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:41.990" end="00:02:47.750">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
        <tt:br />
        <tt:span style="textWhite">Südeuropa. Hitze in vielen Ländern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:48.270" end="00:02:52.630">
        <tt:span style="textWhite">In vielen Ländern im Süden</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Europa ist es gerade sehr warm.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:52.670" end="00:02:56.110">
        <tt:span style="textWhite">Es wird manchmal sogar über 40 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:02:56.870" end="00:02:59.750">
        <tt:span style="textWhite">Die Hitze ist</tt:span>
        <tt:br />
        <tt:span style="textWhite">gefährlich für die Menschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:02:59.790" end="00:03:03.150">
        <tt:span style="textWhite">Sie können Probleme</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Gesundheit bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:03.230" end="00:03:08.030">
        <tt:span style="textWhite">Und die Hitze ist auch ein Problem</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Natur und die Wirtschaft.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:08.710" end="00:03:12.150">
        <tt:span style="textWhite">Zu der Hitze in Südeuropa</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommt jetzt ein Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:13.550" end="00:03:16.910">
        <tt:span style="textWhite">Das ist in der Stadt Mailand</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Italien.</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:17.190" end="00:03:21.110">
        <tt:span style="textWhite">In den letzten Tagen war es dort</tt:span>
        <tt:br />
        <tt:span style="textWhite">sehr heiß und schwül.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:21.550" end="00:03:24.710">
        <tt:span style="textWhite">Fast überall in Italien</tt:span>
        <tt:br />
        <tt:span style="textWhite">war das Wetter so.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:25.390" end="00:03:29.750">
        <tt:span style="textWhite">Deswegen haben die Behörden</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Italien eine Warnung gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:30.110" end="00:03:32.470">
        <tt:span style="textWhite">Die Behörden sagen den Menschen :</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:32.510" end="00:03:35.790">
        <tt:span style="textWhite">Passt auf euch auf,</tt:span>
        <tt:br />
        <tt:span style="textWhite">das Wetter ist gefährlich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:35.830" end="00:03:40.950">
        <tt:span style="textWhite">Auch junge Menschen können Probleme</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit der Gesundheit bekommen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:41.710" end="00:03:45.790">
        <tt:span style="textWhite">In vielen Ländern im Süden</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Europa ist es warm.</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:45.830" end="00:03:48.430">
        <tt:span style="textWhite">Zum Beispiel auch in Österreich.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:48.830" end="00:03:50.870">
        <tt:span style="textWhite">In der Hauptstadt Wien</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:50.910" end="00:03:55.430">
        <tt:span style="textWhite">war es in den letzten Tagen</tt:span>
        <tt:br />
        <tt:span style="textWhite">manchmal über 40 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:03:55.470" end="00:03:58.750">
        <tt:span style="textWhite">Und auch in Ungarn ist es sehr heiß.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:03:59.150" end="00:04:01.950">
        <tt:span style="textWhite">Die Menschen versuchen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">sich abzukühlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:04:03.070" end="00:04:06.310">
        <tt:span style="textWhite">Weil es so heiß ist und wenig regnet,</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:06.550" end="00:04:10.070">
        <tt:span style="textWhite">ist auch wenig Wasser</tt:span>
        <tt:br />
        <tt:span style="textWhite">in dem Fluss Donau.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:10.870" end="00:04:13.870">
        <tt:span style="textWhite">Das ist ein Problem</tt:span>
        <tt:br />
        <tt:span style="textWhite">für dieses Atomkraftwerk.</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:13.910" end="00:04:18.750">
        <tt:span style="textWhite">Ohne Wasser aus dem Fluss kann es</tt:span>
        <tt:br />
        <tt:span style="textWhite">nicht gekühlt werden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:19.030" end="00:04:22.790">
        <tt:span style="textWhite">Und ohne Kühlung</tt:span>
        <tt:br />
        <tt:span style="textWhite">kann es nicht viel Strom machen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:24.310" end="00:04:27.750">
        <tt:span style="textWhite">Deshalb sind</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Ungarns Hauptstadt Budapest</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:27.790" end="00:04:33.630">
        <tt:span style="textWhite">gerade viele Lichter an Gebäuden</tt:span>
        <tt:br />
        <tt:span style="textWhite">abends aus, um Strom zu sparen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:34.870" end="00:04:41.190">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
        <tt:br />
        <tt:span style="textWhite">Mallorca: Mittelmeer so warm wie nie.</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:42.150" end="00:04:45.230">
        <tt:span style="textWhite">Mallorca ist eine Insel</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Mittelmeer,</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:45.430" end="00:04:47.790">
        <tt:span style="textWhite">unten im Süden von Europa.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:47.830" end="00:04:50.230">
        <tt:span style="textWhite">Mallorca gehört zu Spanien.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:50.830" end="00:04:54.430">
        <tt:span style="textWhite">Das Wasser</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Mittelmeer bei Mallorca</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:54.470" end="00:04:58.590">
        <tt:span style="textWhite">war jetzt so warm</tt:span>
        <tt:br />
        <tt:span style="textWhite">wie noch nie in Spanien.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:04:58.630" end="00:05:01.350">
        <tt:span style="textWhite">Es war nämlich 33 Grad warm.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:05:01.670" end="00:05:04.390">
        <tt:span style="textWhite">Das warme Wasser ist gefährlich</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:04.430" end="00:05:07.830">
        <tt:span style="textWhite">für Fische und Pflanzen</tt:span>
        <tt:br />
        <tt:span style="textWhite">im Mittelmeer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:07.870" end="00:05:11.590">
        <tt:span style="textWhite">Und wenn das Wetter</tt:span>
        <tt:br />
        <tt:span style="textWhite">jetzt so warm ist,</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:12.070" end="00:05:15.150">
        <tt:span style="textWhite">dann kann es im Herbst</tt:span>
        <tt:br />
        <tt:span style="textWhite">heftige Stürme geben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:15.670" end="00:05:20.630">
        <tt:span style="textWhite">Forscher sagen, das warme Wasser</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommt vom Klimawandel.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:21.470" end="00:05:25.390">
        <tt:span style="textWhite">Klimawandel heißt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf der Erde wird es wärmer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:25.710" end="00:05:29.870">
        <tt:span style="textWhite">Das ist gefährlich für die Natur</tt:span>
        <tt:br />
        <tt:span style="textWhite">und für die Menschen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:31.120" end="00:05:33.480">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:46.680" end="00:05:48.600">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:49.870" end="00:05:51.830">
        <tt:span style="textWhite">Es ist sonnig und trocken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:52.270" end="00:05:55.870">
        <tt:span style="textWhite">Oben an der Küste</tt:span>
        <tt:br />
        <tt:span style="textWhite">und unten an den Bergen</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:55.910" end="00:05:58.590">
        <tt:span style="textWhite">kann es ein paar Wolken geben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:58.630" end="00:06:00.950">
        <tt:span style="textWhite">Es werden 20 bis 34 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:06:02.070" end="00:06:05.430">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:06:06.360" end="00:06:08.520">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:06:12.800" end="00:06:14.960">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
