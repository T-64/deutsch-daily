      <tt:region xml:id="top" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" />
      <tt:region xml:id="bottom" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" />
    </tt:layout>
  </tt:head>
  <tt:body>
    <tt:div style="defaultStyle">
      <tt:p xml:id="sub0" style="textCenter" region="bottom" begin="00:00:01.680" end="00:00:02.680">
        <tt:span style="textWhite">* Gong *</tt:span>
      </tt:p>
      <tt:p xml:id="sub1" style="textCenter" region="bottom" begin="00:00:03.040" end="00:00:05.760">
        <tt:span style="textBlue">Untertitel:</tt:span>
        <tt:br />
        <tt:span style="textBlue">Norddeutscher Rundfunk 2026</tt:span>
      </tt:p>
      <tt:p xml:id="sub2" style="textCenter" region="bottom" begin="00:00:08.790" end="00:00:11.990">
        <tt:span style="textWhite">Willkommen zur tagesschau in</tt:span>
        <tt:br />
        <tt:span style="textWhite">Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub3" style="textCenter" region="bottom" begin="00:00:12.070" end="00:00:13.910">
        <tt:span style="textWhite">Ich bin Michael Paweletz.</tt:span>
      </tt:p>
      <tt:p xml:id="sub4" style="textCenter" region="bottom" begin="00:00:14.150" end="00:00:16.470">
        <tt:span style="textWhite">Und das sind unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub5" style="textCenter" region="bottom" begin="00:00:38.240" end="00:00:40.320">
        <tt:span style="textWhite">Und nun zur ersten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub6" style="textCenter" region="bottom" begin="00:00:46.310" end="00:00:48.430">
        <tt:span style="textWhite">Wenn ein Mensch alt ist,</tt:span>
      </tt:p>
      <tt:p xml:id="sub7" style="textCenter" region="bottom" begin="00:00:48.830" end="00:00:52.750">
        <tt:span style="textWhite">dann muss er nicht mehr arbeiten</tt:span>
        <tt:br />
        <tt:span style="textWhite">und bekommt Rente.</tt:span>
      </tt:p>
      <tt:p xml:id="sub8" style="textCenter" region="bottom" begin="00:00:53.310" end="00:00:55.670">
        <tt:span style="textWhite">Rente ist Geld vom Staat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub9" style="textCenter" region="bottom" begin="00:00:56.550" end="00:00:59.910">
        <tt:span style="textWhite">Einige Menschen bekommen aber</tt:span>
        <tt:br />
        <tt:span style="textWhite">nur wenig Rente</tt:span>
      </tt:p>
      <tt:p xml:id="sub10" style="textCenter" region="bottom" begin="00:00:59.950" end="00:01:02.750">
        <tt:span style="textWhite">und haben nicht genug Geld zum Leben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub11" style="textCenter" region="bottom" begin="00:01:04.080" end="00:01:06.160">
        <tt:span style="textWhite">Deshalb sagt die Regierung,</tt:span>
      </tt:p>
      <tt:p xml:id="sub12" style="textCenter" region="bottom" begin="00:01:06.200" end="00:01:09.590">
        <tt:span style="textWhite">die Menschen sollen vor der Rente</tt:span>
        <tt:br />
        <tt:span style="textWhite">Geld sparen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub13" style="textCenter" region="bottom" begin="00:01:10.440" end="00:01:13.520">
        <tt:span style="textWhite">Dann haben sie mehr Geld,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wenn sie alt sind.</tt:span>
      </tt:p>
      <tt:p xml:id="sub14" style="textCenter" region="bottom" begin="00:01:14.800" end="00:01:17.440">
        <tt:span style="textWhite">Die Regierung</tt:span>
        <tt:br />
        <tt:span style="textWhite">will beim Sparen helfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub15" style="textCenter" region="bottom" begin="00:01:17.710" end="00:01:20.950">
        <tt:span style="textWhite">Deshalb hat sie</tt:span>
        <tt:br />
        <tt:span style="textWhite">jetzt einen Beschluss gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub16" style="textCenter" region="bottom" begin="00:01:22.360" end="00:01:26.640">
        <tt:span style="textWhite">Der Staat gibt jungen Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">jeden Monat ein bisschen Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub17" style="textCenter" region="bottom" begin="00:01:27.560" end="00:01:30.120">
        <tt:span style="textWhite">Das Geld kommt</tt:span>
        <tt:br />
        <tt:span style="textWhite">zum Sparen auf ein Konto</tt:span>
      </tt:p>
      <tt:p xml:id="sub18" style="textCenter" region="bottom" begin="00:01:30.200" end="00:01:31.280">
        <tt:span style="textWhite">bei der Bank.</tt:span>
      </tt:p>
      <tt:p xml:id="sub19" style="textCenter" region="bottom" begin="00:01:32.640" end="00:01:34.560">
        <tt:span style="textWhite">Wenn die Menschen alt sind.</tt:span>
      </tt:p>
      <tt:p xml:id="sub20" style="textCenter" region="bottom" begin="00:01:34.600" end="00:01:37.440">
        <tt:span style="textWhite">Wenn die Menschen alt</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind und in Rente gehen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub21" style="textCenter" region="bottom" begin="00:01:37.480" end="00:01:38.800">
        <tt:span style="textWhite">bekommen sie das Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub22" style="textCenter" region="bottom" begin="00:01:38.920" end="00:01:40.400">
        <tt:span style="textWhite">Die Regierung sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub23" style="textCenter" region="bottom" begin="00:01:40.440" end="00:01:43.910">
        <tt:span style="textWhite">dann haben alte Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">genug Geld zum Leben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub24" style="textCenter" region="bottom" begin="00:01:46.720" end="00:01:49.080">
        <tt:span style="textWhite">Um einen Beschluss</tt:span>
        <tt:br />
        <tt:span style="textWhite">von der Regierung</tt:span>
      </tt:p>
      <tt:p xml:id="sub25" style="textCenter" region="bottom" begin="00:01:49.120" end="00:01:51.630">
        <tt:span style="textWhite">geht es auch</tt:span>
        <tt:br />
        <tt:span style="textWhite">in der nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub26" style="textCenter" region="bottom" begin="00:01:56.230" end="00:02:00.030">
        <tt:span style="textWhite">Viele Menschen in Deutschland</tt:span>
        <tt:br />
        <tt:span style="textWhite">rauchen Zigaretten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub27" style="textCenter" region="bottom" begin="00:02:00.270" end="00:02:02.270">
        <tt:span style="textWhite">So wie auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub28" style="textCenter" region="bottom" begin="00:02:03.360" end="00:02:07.800">
        <tt:span style="textWhite">Wenn man Zigaretten kauft,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dann bezahlt man dabei auch Steuern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub29" style="textCenter" region="bottom" begin="00:02:08.990" end="00:02:11.550">
        <tt:span style="textWhite">Steuern sind Geld für den Staat.</tt:span>
      </tt:p>
      <tt:p xml:id="sub30" style="textCenter" region="bottom" begin="00:02:12.390" end="00:02:15.590">
        <tt:span style="textWhite">Jetzt hat die Regierung</tt:span>
        <tt:br />
        <tt:span style="textWhite">einen Beschluss gemacht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub31" style="textCenter" region="bottom" begin="00:02:16.040" end="00:02:17.400">
        <tt:span style="textWhite">Die Regierung sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub32" style="textCenter" region="bottom" begin="00:02:17.670" end="00:02:20.790">
        <tt:span style="textWhite">wir machen die Steuern</tt:span>
        <tt:br />
        <tt:span style="textWhite">für Zigaretten höher.</tt:span>
      </tt:p>
      <tt:p xml:id="sub33" style="textCenter" region="bottom" begin="00:02:21.800" end="00:02:23.880">
        <tt:span style="textWhite">D.h. Zigaretten</tt:span>
        <tt:br />
        <tt:span style="textWhite">werden teurer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub34" style="textCenter" region="bottom" begin="00:02:25.480" end="00:02:29.800">
        <tt:span style="textWhite">Wenn die Steuern höher werden,</tt:span>
        <tt:br />
        <tt:span style="textWhite">dann bekommt der Staat mehr Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub35" style="textCenter" region="bottom" begin="00:02:31.240" end="00:02:34.360">
        <tt:span style="textWhite">Der Minister für Geld,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Lars Klingbeil, sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub36" style="textCenter" region="bottom" begin="00:02:34.870" end="00:02:39.510">
        <tt:span style="textWhite">damit bezahlen wir z.B.</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Schulden von Deutschland.</tt:span>
      </tt:p>
      <tt:p xml:id="sub37" style="textCenter" region="bottom" begin="00:02:41.000" end="00:02:45.240">
        <tt:span style="textWhite">Viele Menschen finden die höheren</tt:span>
        <tt:br />
        <tt:span style="textWhite">Steuern aber nicht gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub38" style="textCenter" region="bottom" begin="00:02:45.510" end="00:02:47.710">
        <tt:span style="textWhite">Dazu zeigen wir einen Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub39" style="textCenter" region="bottom" begin="00:02:50.200" end="00:02:51.760">
        <tt:span style="textWhite">Das ist Melanie Knabe.</tt:span>
      </tt:p>
      <tt:p xml:id="sub40" style="textCenter" region="bottom" begin="00:02:52.960" end="00:02:54.960">
        <tt:span style="textWhite">Sie hat einen kleinen Laden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub41" style="textCenter" region="bottom" begin="00:02:56.070" end="00:02:59.590">
        <tt:span style="textWhite">Dort verkauft sie jeden Tag</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Zigaretten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub42" style="textCenter" region="bottom" begin="00:03:00.480" end="00:03:04.000">
        <tt:span style="textWhite">Sie sagt, die höheren Steuern</tt:span>
        <tt:br />
        <tt:span style="textWhite">finde ich nicht gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub43" style="textCenter" region="bottom" begin="00:03:04.750" end="00:03:08.350">
        <tt:span style="textWhite">Vielleicht kaufen die Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">dann weniger Zigaretten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub44" style="textCenter" region="bottom" begin="00:03:08.390" end="00:03:11.270">
        <tt:span style="textWhite">Und dann verdiene ich weniger Geld.</tt:span>
      </tt:p>
      <tt:p xml:id="sub45" style="textCenter" region="bottom" begin="00:03:12.350" end="00:03:16.670">
        <tt:span style="textWhite">Die Regierung sagt aber,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wenn die Menschen weniger rauchen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub46" style="textCenter" region="bottom" begin="00:03:17.470" end="00:03:20.030">
        <tt:span style="textWhite">dann ist das gut für die Gesundheit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub47" style="textCenter" region="bottom" begin="00:03:20.830" end="00:03:25.310">
        <tt:span style="textWhite">Einige Menschen finden</tt:span>
        <tt:br />
        <tt:span style="textWhite">die höheren Steuern aber auch gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub48" style="textCenter" region="bottom" begin="00:03:26.470" end="00:03:30.950">
        <tt:span style="textWhite">Dieser Mann sagt, Zigaretten</tt:span>
        <tt:br />
        <tt:span style="textWhite">sollen noch teurer werden.</tt:span>
      </tt:p>
      <tt:p xml:id="sub49" style="textCenter" region="bottom" begin="00:03:31.880" end="00:03:34.960">
        <tt:span style="textWhite">Dann kann der Staat</tt:span>
        <tt:br />
        <tt:span style="textWhite">seine Schulden bezahlen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub50" style="textCenter" region="bottom" begin="00:03:35.800" end="00:03:39.000">
        <tt:span style="textWhite">Und außerdem ist es</tt:span>
        <tt:br />
        <tt:span style="textWhite">für die Menschen gesünder.</tt:span>
      </tt:p>
      <tt:p xml:id="sub51" style="textCenter" region="bottom" begin="00:03:41.550" end="00:03:45.270">
        <tt:span style="textWhite">Viele Raucher</tt:span>
        <tt:br />
        <tt:span style="textWhite">finden die höheren Steuern nicht gut.</tt:span>
      </tt:p>
      <tt:p xml:id="sub52" style="textCenter" region="bottom" begin="00:03:46.600" end="00:03:50.120">
        <tt:span style="textWhite">Dieser Mann sagt,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wenn Zigaretten zu teuer werden,</tt:span>
      </tt:p>
      <tt:p xml:id="sub53" style="textCenter" region="bottom" begin="00:03:50.630" end="00:03:53.070">
        <tt:span style="textWhite">dann muss ich aufhören zu rauchen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub54" style="textCenter" region="bottom" begin="00:03:54.350" end="00:03:57.630">
        <tt:span style="textWhite">Hören jetzt viele Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit dem Rauchen auf?</tt:span>
      </tt:p>
      <tt:p xml:id="sub55" style="textCenter" region="bottom" begin="00:03:58.280" end="00:04:00.480">
        <tt:span style="textWhite">Das glaubt Melanie Knabe nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub56" style="textCenter" region="bottom" begin="00:04:01.280" end="00:04:05.120">
        <tt:span style="textWhite">Sie sagt, die meisten Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">rauchen bestimmt weiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub57" style="textCenter" region="bottom" begin="00:04:06.430" end="00:04:07.870">
        <tt:span style="textWhite">Experten sagen,</tt:span>
      </tt:p>
      <tt:p xml:id="sub58" style="textCenter" region="bottom" begin="00:04:08.280" end="00:04:12.800">
        <tt:span style="textWhite">seit vielen Jahren rauchen</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Menschen in Deutschland weniger.</tt:span>
      </tt:p>
      <tt:p xml:id="sub59" style="textCenter" region="bottom" begin="00:04:15.680" end="00:04:17.320">
        <tt:span style="textWhite">Zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub60" style="textCenter" region="bottom" begin="00:04:23.600" end="00:04:26.320">
        <tt:span style="textWhite">In den USA hat ein Mann</tt:span>
        <tt:br />
        <tt:span style="textWhite">in einer Schule</tt:span>
      </tt:p>
      <tt:p xml:id="sub61" style="textCenter" region="bottom" begin="00:04:26.790" end="00:04:28.710">
        <tt:span style="textWhite">mit einer Waffe geschossen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub62" style="textCenter" region="bottom" begin="00:04:28.750" end="00:04:30.830">
        <tt:span style="textWhite">Die Schule ist auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub63" style="textCenter" region="bottom" begin="00:04:31.510" end="00:04:34.670">
        <tt:span style="textWhite">Der junge Mann</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat mehrere Menschen getötet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub64" style="textCenter" region="bottom" begin="00:04:35.070" end="00:04:37.470">
        <tt:span style="textWhite">Auch Kinder sind dabei gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub65" style="textCenter" region="bottom" begin="00:04:38.150" end="00:04:40.670">
        <tt:span style="textWhite">Der Mann mit der Waffe ist auch tot.</tt:span>
      </tt:p>
      <tt:p xml:id="sub66" style="textCenter" region="bottom" begin="00:04:41.480" end="00:04:46.000">
        <tt:span style="textWhite">Warum hat der Mann geschossen,</tt:span>
        <tt:br />
        <tt:span style="textWhite">das untersucht jetzt die Polizei.</tt:span>
      </tt:p>
      <tt:p xml:id="sub67" style="textCenter" region="bottom" begin="00:04:46.230" end="00:04:48.310">
        <tt:span style="textWhite">Dazu zeigen wir einen Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub68" style="textCenter" region="bottom" begin="00:04:50.350" end="00:04:53.190">
        <tt:span style="textWhite">Die Schule</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist in dem Bundesstaat Oregon.</tt:span>
      </tt:p>
      <tt:p xml:id="sub69" style="textCenter" region="bottom" begin="00:04:54.030" end="00:04:56.830">
        <tt:span style="textWhite">Vor der Schule</tt:span>
        <tt:br />
        <tt:span style="textWhite">stehen viele Polizisten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub70" style="textCenter" region="bottom" begin="00:04:57.230" end="00:05:02.910">
        <tt:span style="textWhite">Sie wollen jetzt herausfinden,</tt:span>
        <tt:br />
        <tt:span style="textWhite">was genau ist in der Schule passiert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub71" style="textCenter" region="bottom" begin="00:05:03.870" end="00:05:07.350">
        <tt:span style="textWhite">Auch die Familien</tt:span>
        <tt:br />
        <tt:span style="textWhite">von den Schülern sind da.</tt:span>
      </tt:p>
      <tt:p xml:id="sub72" style="textCenter" region="bottom" begin="00:05:08.190" end="00:05:11.350">
        <tt:span style="textWhite">Sie warten auf Nachrichten</tt:span>
        <tt:br />
        <tt:span style="textWhite">von ihren Kindern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub73" style="textCenter" region="bottom" begin="00:05:11.990" end="00:05:14.750">
        <tt:span style="textWhite">Die Familien</tt:span>
        <tt:br />
        <tt:span style="textWhite">machen sich große Sorgen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub74" style="textCenter" region="bottom" begin="00:05:16.070" end="00:05:18.830">
        <tt:span style="textWhite">Der Chef von der Polizei sagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub75" style="textCenter" region="bottom" begin="00:05:19.350" end="00:05:22.350">
        <tt:span style="textWhite">bei dem Angriff</tt:span>
        <tt:br />
        <tt:span style="textWhite">sind drei Kinder gestorben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub76" style="textCenter" region="bottom" begin="00:05:23.190" end="00:05:25.590">
        <tt:span style="textWhite">Auch eine Lehrerin ist tot.</tt:span>
      </tt:p>
      <tt:p xml:id="sub77" style="textCenter" region="bottom" begin="00:05:25.830" end="00:05:28.830">
        <tt:span style="textWhite">Und mehrere Menschen sind verletzt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub78" style="textCenter" region="bottom" begin="00:05:29.750" end="00:05:33.150">
        <tt:span style="textWhite">Der Mann mit der Waffe</tt:span>
        <tt:br />
        <tt:span style="textWhite">war 16 Jahre alt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub79" style="textCenter" region="bottom" begin="00:05:34.400" end="00:05:35.560">
        <tt:span style="textWhite">Er ist auch tot.</tt:span>
      </tt:p>
      <tt:p xml:id="sub80" style="textCenter" region="bottom" begin="00:05:36.470" end="00:05:39.590">
        <tt:span style="textWhite">Ein Mann aus der Nachbarschaft</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat ihn erschossen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub81" style="textCenter" region="bottom" begin="00:05:42.830" end="00:05:46.470">
        <tt:span style="textWhite">Am Abend zünden die Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">Kerzen für die Toten an.</tt:span>
      </tt:p>
      <tt:p xml:id="sub82" style="textCenter" region="bottom" begin="00:05:47.430" end="00:05:50.350">
        <tt:span style="textWhite">Viele fragen sich,</tt:span>
        <tt:br />
        <tt:span style="textWhite">wieso ist das passiert?</tt:span>
      </tt:p>
      <tt:p xml:id="sub83" style="textCenter" region="bottom" begin="00:05:52.200" end="00:05:56.200">
        <tt:span style="textWhite">Dieser Mann sagt, ich</tt:span>
        <tt:br />
        <tt:span style="textWhite">habe gerade in der Nähe gearbeitet.</tt:span>
      </tt:p>
      <tt:p xml:id="sub84" style="textCenter" region="bottom" begin="00:05:56.990" end="00:05:59.150">
        <tt:span style="textWhite">Dann kamen viele Polizisten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub85" style="textCenter" region="bottom" begin="00:05:59.190" end="00:06:03.030">
        <tt:span style="textWhite">Meine Schwester</tt:span>
        <tt:br />
        <tt:span style="textWhite">hat mich angerufen und gesagt,</tt:span>
      </tt:p>
      <tt:p xml:id="sub86" style="textCenter" region="bottom" begin="00:06:03.430" end="00:06:05.590">
        <tt:span style="textWhite">in der Schule wird geschossen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub87" style="textCenter" region="bottom" begin="00:06:06.270" end="00:06:09.470">
        <tt:span style="textWhite">Unserer Familie ist zum Glück</tt:span>
        <tt:br />
        <tt:span style="textWhite">nichts passiert.</tt:span>
      </tt:p>
      <tt:p xml:id="sub88" style="textCenter" region="bottom" begin="00:06:10.270" end="00:06:13.110">
        <tt:span style="textWhite">Aber ich bin sehr</tt:span>
        <tt:br />
        <tt:span style="textWhite">traurig über die Toten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub89" style="textCenter" region="bottom" begin="00:06:13.670" end="00:06:16.110">
        <tt:span style="textWhite">Ich kann es einfach nicht glauben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub90" style="textCenter" region="bottom" begin="00:06:17.670" end="00:06:22.470">
        <tt:span style="textWhite">Überall in den USA trauern</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Menschen jetzt um die Toten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub91" style="textCenter" region="bottom" begin="00:06:23.790" end="00:06:26.550">
        <tt:span style="textWhite">Und nun zur nächsten Nachricht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub92" style="textCenter" region="bottom" begin="00:06:31.880" end="00:06:35.680">
        <tt:span style="textWhite">In Belgien ist heute</tt:span>
        <tt:br />
        <tt:span style="textWhite">ein wichtiges Treffen von der EU.</tt:span>
      </tt:p>
      <tt:p xml:id="sub93" style="textCenter" region="bottom" begin="00:06:36.360" end="00:06:37.920">
        <tt:span style="textWhite">Die Länder von der EU</tt:span>
      </tt:p>
      <tt:p xml:id="sub94" style="textCenter" region="bottom" begin="00:06:37.960" end="00:06:42.550">
        <tt:span style="textWhite">sprechen nämlich über den Krieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">von Russland gegen die Ukraine.</tt:span>
      </tt:p>
      <tt:p xml:id="sub95" style="textCenter" region="bottom" begin="00:06:43.480" end="00:06:47.400">
        <tt:span style="textWhite">Auch der Präsident von der Ukraine,</tt:span>
        <tt:br />
        <tt:span style="textWhite">Wolodymyr Selenskyj,</tt:span>
      </tt:p>
      <tt:p xml:id="sub96" style="textCenter" region="bottom" begin="00:06:47.520" end="00:06:48.840">
        <tt:span style="textWhite">ist bei dem Treffen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub97" style="textCenter" region="bottom" begin="00:06:49.720" end="00:06:52.520">
        <tt:span style="textWhite">Selenskyj ist in der Mitte</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf dem Foto.</tt:span>
      </tt:p>
      <tt:p xml:id="sub98" style="textCenter" region="bottom" begin="00:06:53.240" end="00:06:55.840">
        <tt:span style="textWhite">Die Länder von der EU beraten,</tt:span>
      </tt:p>
      <tt:p xml:id="sub99" style="textCenter" region="bottom" begin="00:06:56.040" end="00:06:59.600">
        <tt:span style="textWhite">wie kann die EU der Ukraine im Krieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">weiter helfen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub100" style="textCenter" region="bottom" begin="00:07:00.750" end="00:07:04.590">
        <tt:span style="textWhite">Russland greift die Ukraine</tt:span>
        <tt:br />
        <tt:span style="textWhite">nämlich immer noch an.</tt:span>
      </tt:p>
      <tt:p xml:id="sub101" style="textCenter" region="bottom" begin="00:07:05.390" end="00:07:09.590">
        <tt:span style="textWhite">Besonders viele Angriffe</tt:span>
        <tt:br />
        <tt:span style="textWhite">gibt es in der Hauptstadt Kiew.</tt:span>
      </tt:p>
      <tt:p xml:id="sub102" style="textCenter" region="bottom" begin="00:07:10.150" end="00:07:12.510">
        <tt:span style="textWhite">Dazu zeigen wir jetzt einen Film.</tt:span>
      </tt:p>
      <tt:p xml:id="sub103" style="textCenter" region="bottom" begin="00:07:14.400" end="00:07:17.680">
        <tt:span style="textWhite">In Kiew fahren die Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">nach der Arbeit</tt:span>
      </tt:p>
      <tt:p xml:id="sub104" style="textCenter" region="bottom" begin="00:07:17.720" end="00:07:19.470">
        <tt:span style="textWhite">mit dem Bus nach Hause.</tt:span>
      </tt:p>
      <tt:p xml:id="sub105" style="textCenter" region="bottom" begin="00:07:20.600" end="00:07:23.880">
        <tt:span style="textWhite">Auf dem Weg müssen sie</tt:span>
        <tt:br />
        <tt:span style="textWhite">über eine Brücke fahren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub106" style="textCenter" region="bottom" begin="00:07:24.240" end="00:07:26.080">
        <tt:span style="textWhite">Viele haben deshalb Angst.</tt:span>
      </tt:p>
      <tt:p xml:id="sub107" style="textCenter" region="bottom" begin="00:07:27.600" end="00:07:31.600">
        <tt:span style="textWhite">Russland schießt nämlich oft</tt:span>
        <tt:br />
        <tt:span style="textWhite">mit Raketen auf die Brücken.</tt:span>
      </tt:p>
      <tt:p xml:id="sub108" style="textCenter" region="bottom" begin="00:07:32.520" end="00:07:34.360">
        <tt:span style="textWhite">So wie auf diesen Bildern.</tt:span>
      </tt:p>
      <tt:p xml:id="sub109" style="textCenter" region="bottom" begin="00:07:35.760" end="00:07:37.280">
        <tt:span style="textWhite">Sie sind schon älter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub110" style="textCenter" region="bottom" begin="00:07:39.430" end="00:07:43.670">
        <tt:span style="textWhite">Ohne den Bus oder das Auto</tt:span>
        <tt:br />
        <tt:span style="textWhite">kommen viele nicht zur Arbeit.</tt:span>
      </tt:p>
      <tt:p xml:id="sub111" style="textCenter" region="bottom" begin="00:07:44.760" end="00:07:46.040">
        <tt:span style="textWhite">So wie diese Frau.</tt:span>
      </tt:p>
      <tt:p xml:id="sub112" style="textCenter" region="bottom" begin="00:07:46.840" end="00:07:49.040">
        <tt:span style="textWhite">Sie sagt, ich habe immer Angst.</tt:span>
      </tt:p>
      <tt:p xml:id="sub113" style="textCenter" region="bottom" begin="00:07:49.760" end="00:07:52.560">
        <tt:span style="textWhite">Es kann ja jeden Moment</tt:span>
        <tt:br />
        <tt:span style="textWhite">etwas passieren.</tt:span>
      </tt:p>
      <tt:p xml:id="sub114" style="textCenter" region="bottom" begin="00:07:52.960" end="00:07:55.960">
        <tt:span style="textWhite">Mit dieser Angst zu leben,</tt:span>
        <tt:br />
        <tt:span style="textWhite">ist sehr schwer.</tt:span>
      </tt:p>
      <tt:p xml:id="sub115" style="textCenter" region="bottom" begin="00:07:57.750" end="00:08:01.630">
        <tt:span style="textWhite">In der Nacht hat Russland</tt:span>
        <tt:br />
        <tt:span style="textWhite">Kiew wieder angegriffen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub116" style="textCenter" region="bottom" begin="00:08:02.310" end="00:08:06.510">
        <tt:span style="textWhite">Die Raketen treffen</tt:span>
        <tt:br />
        <tt:span style="textWhite">auch wichtige Anlagen für Strom.</tt:span>
      </tt:p>
      <tt:p xml:id="sub117" style="textCenter" region="bottom" begin="00:08:07.510" end="00:08:11.590">
        <tt:span style="textWhite">Deshalb gibt es oft</tt:span>
        <tt:br />
        <tt:span style="textWhite">viele Tage lang keinen Strom.</tt:span>
      </tt:p>
      <tt:p xml:id="sub118" style="textCenter" region="bottom" begin="00:08:12.800" end="00:08:15.960">
        <tt:span style="textWhite">Und dann</tt:span>
        <tt:br />
        <tt:span style="textWhite">funktioniert auch die Heizung nicht.</tt:span>
      </tt:p>
      <tt:p xml:id="sub119" style="textCenter" region="bottom" begin="00:08:16.910" end="00:08:18.830">
        <tt:span style="textWhite">Bald kommt aber der Winter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub120" style="textCenter" region="bottom" begin="00:08:19.710" end="00:08:22.910">
        <tt:span style="textWhite">Deshalb verlassen viele Menschen</tt:span>
        <tt:br />
        <tt:span style="textWhite">die Stadt.</tt:span>
      </tt:p>
      <tt:p xml:id="sub121" style="textCenter" region="bottom" begin="00:08:24.830" end="00:08:27.190">
        <tt:span style="textWhite">Dieser Mann will in Kiew bleiben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub122" style="textCenter" region="bottom" begin="00:08:27.670" end="00:08:31.430">
        <tt:span style="textWhite">Er sagt, wir bereiten uns</tt:span>
        <tt:br />
        <tt:span style="textWhite">auf den Winter vor.</tt:span>
      </tt:p>
      <tt:p xml:id="sub123" style="textCenter" region="bottom" begin="00:08:32.440" end="00:08:34.000">
        <tt:span style="textWhite">Wir sammeln viel Holz.</tt:span>
      </tt:p>
      <tt:p xml:id="sub124" style="textCenter" region="bottom" begin="00:08:34.640" end="00:08:37.440">
        <tt:span style="textWhite">Dann können wir Feuer</tt:span>
        <tt:br />
        <tt:span style="textWhite">machen und kochen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub125" style="textCenter" region="bottom" begin="00:08:41.070" end="00:08:46.030">
        <tt:span style="textWhite">Auch der Busfahrer will im Winter</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Kiew bleiben und arbeiten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub126" style="textCenter" region="bottom" begin="00:08:47.320" end="00:08:50.120">
        <tt:span style="textWhite">Er fährt seit vielen Jahren</tt:span>
        <tt:br />
        <tt:span style="textWhite">Bus in Kiew.</tt:span>
      </tt:p>
      <tt:p xml:id="sub127" style="textCenter" region="bottom" begin="00:08:51.030" end="00:08:53.190">
        <tt:span style="textWhite">Und das soll auch so bleiben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub128" style="textCenter" region="bottom" begin="00:08:54.680" end="00:08:58.840">
        <tt:span style="textWhite">Der Busfahrer sagt, der Krieg</tt:span>
        <tt:br />
        <tt:span style="textWhite">dauert schon fünf Jahre lang.</tt:span>
      </tt:p>
      <tt:p xml:id="sub129" style="textCenter" region="bottom" begin="00:09:00.160" end="00:09:03.360">
        <tt:span style="textWhite">Wir haben uns daran</tt:span>
        <tt:br />
        <tt:span style="textWhite">gewöhnt und machen weiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub130" style="textCenter" region="bottom" begin="00:09:03.760" end="00:09:05.480">
        <tt:span style="textWhite">Auch wenn es schwer ist.</tt:span>
      </tt:p>
      <tt:p xml:id="sub131" style="textCenter" region="bottom" begin="00:09:07.120" end="00:09:08.840">
        <tt:span style="textWhite">Man muss ja weiterleben.</tt:span>
      </tt:p>
      <tt:p xml:id="sub132" style="textCenter" region="bottom" begin="00:09:09.550" end="00:09:11.750">
        <tt:span style="textWhite">Und dann fährt er weiter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub133" style="textCenter" region="bottom" begin="00:09:12.800" end="00:09:15.000">
        <tt:span style="textWhite">Zurück in das Zentrum von Kiew.</tt:span>
      </tt:p>
      <tt:p xml:id="sub134" style="textCenter" region="bottom" begin="00:09:17.560" end="00:09:19.920">
        <tt:span style="textWhite">Und das waren unsere Nachrichten.</tt:span>
      </tt:p>
      <tt:p xml:id="sub135" style="textCenter" region="bottom" begin="00:09:38.480" end="00:09:40.400">
        <tt:span style="textWhite">Und jetzt kommt das Wetter.</tt:span>
      </tt:p>
      <tt:p xml:id="sub136" style="textCenter" region="bottom" begin="00:09:41.400" end="00:09:44.200">
        <tt:span style="textWhite">Links im Westen gibt es</tt:span>
        <tt:br />
        <tt:span style="textWhite">ein wenig Sonne.</tt:span>
      </tt:p>
      <tt:p xml:id="sub137" style="textCenter" region="bottom" begin="00:09:44.440" end="00:09:47.080">
        <tt:span style="textWhite">Sonst überall viele Wolken und Regen.</tt:span>
      </tt:p>
      <tt:p xml:id="sub138" style="textCenter" region="bottom" begin="00:09:47.880" end="00:09:49.600">
        <tt:span style="textWhite">Es werden 8 bis 18 Grad.</tt:span>
      </tt:p>
      <tt:p xml:id="sub139" style="textCenter" region="bottom" begin="00:09:52.440" end="00:09:55.520">
        <tt:span style="textWhite">Das war die tagesschau</tt:span>
        <tt:br />
        <tt:span style="textWhite">in Einfacher Sprache.</tt:span>
      </tt:p>
      <tt:p xml:id="sub140" style="textCenter" region="bottom" begin="00:09:55.600" end="00:09:57.760">
        <tt:span style="textWhite">Tschüss, bis zum nächsten Mal.</tt:span>
      </tt:p>
      <tt:p xml:id="sub141" style="textCenter" region="bottom" begin="00:10:00.360" end="00:10:02.520">
        <tt:span style="textBlue">Copyright Untertitel: NDR 2026</tt:span>
      </tt:p>
